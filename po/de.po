"Weißer Text verwendet das dunkle Panel-Thema; schwarzer Text verwendet das "
"helle Panel-Thema"

#: prefs/panelAppearancePage.js:344
msgid "Taskbar Text Color"
msgstr "Textfarbe der Taskleiste"

#: prefs/panelAppearancePage.js:347
msgid "White"
