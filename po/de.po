msgstr "Bewegt die Start-Schaltfläche zusammen mit den Anwendungsschaltflächen"

#: prefs/startMenuPage.js:126
msgid "Start Button Padding"
msgstr "Innenabstand der Start-Schaltfläche"

#: prefs/startMenuPage.js:127
msgid "Horizontal space around the Start icon in pixels"
msgstr "Horizontaler Abstand um das Start-Symbol in Pixel"

#: prefs/startMenuPage.js:134
