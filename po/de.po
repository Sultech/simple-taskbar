msgid "Largest preview height in pixels; widths follow each window’s shape"
msgstr ""
"Maximale Vorschauhöhe in Pixel; die Breite richtet sich nach der Form jedes "
"Fensters"

#: prefs.js:218 prefs.js:547
msgid "Isolate Workspaces"
msgstr "Arbeitsflächen isolieren"

#: prefs.js:220
msgid "Show windows from the current workspace instead of all workspaces"
msgstr ""
"Zeigt Fenster der aktuellen Arbeitsfläche anstelle aller Arbeitsflächen"

#: prefs.js:234 prefs.js:560
msgid "Isolate Monitors"
msgstr "Monitore isolieren"

#: prefs.js:236
msgid "Show only windows from the monitor displaying the switcher"
msgstr "Zeigt nur Fenster des Monitors, auf dem der Wechsler angezeigt wird"

#: prefs.js:250
msgid "Show on Primary Monitor"
msgstr "Auf Hauptmonitor anzeigen"

#: prefs.js:252
msgid "Always display the switcher on the primary monitor"
msgstr "Zeigt den Wechsler immer auf dem Hauptmonitor an"

#: prefs.js:279 prefs.js:1175 prefs.js:1838
msgid "Start Button"
msgstr "Start-Schaltfläche"

#: prefs.js:280
msgid "Configure the Start button position and spacing."
msgstr "Konfigurieren Sie Position und Abstand der Start-Schaltfläche."

#: prefs.js:285 prefs.js:1270
msgid "Eleven-style Start Menu"
msgstr "Startmenü im Eleven-Stil"

#: prefs.js:286
msgid "Configure the optional Eleven-style application menu."
msgstr "Konfigurieren Sie das optionale Anwendungsmenü im Eleven-Stil."

#: prefs.js:291
msgid "Keyboard Shortcuts"
msgstr "Tastenkombinationen"

#: prefs.js:292
msgid "Configure Start menu shortcuts."
msgstr "Konfigurieren Sie Tastenkombinationen für das Startmenü."

#: prefs.js:318
msgid "General"
msgstr "Allgemein"

#: prefs.js:323
msgid "Default GNOME Panel"
msgstr "Standard-GNOME-Panel"

#: prefs.js:324
msgid "Hide taskbar applications and use the original Dash in Overview"
msgstr ""
"Blendet Taskleisten-Anwendungen aus und verwendet das ursprüngliche Dash in "
"der Übersicht"

#: prefs.js:332
msgid "Panel Button Padding"
msgstr "Innenabstand der Panel-Schaltflächen"

#: prefs.js:334
msgid ""
"Horizontal space around panel buttons. Use -1 for automatic: Just "
"Perfection’s value when it is configured, otherwise 3 px"
msgstr ""
"Horizontaler Abstand um die Panel-Schaltflächen. Verwenden Sie -1 für "
"automatisch: der Wert von Just Perfection, wenn konfiguriert, sonst 3 px"

#: prefs.js:341
msgid "Application Icons"
msgstr "Anwendungssymbole"

