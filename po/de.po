#: prefs.js:167
msgid "File manager shortcuts and taskbar menu folders."
msgstr "Verknüpfungen des Dateimanagers und Ordner im Taskleistenmenü."

#: prefs.js:175
msgid "Less commonly used Start menu options."
msgstr "Weniger häufig verwendete Optionen des Startmenüs."

#: prefs.js:181
msgid "Grid Alt-Tab"
msgstr "Raster-Alt-Tab"

#: prefs.js:183
msgid "Switch directly between open windows using live previews."
msgstr "Wechseln Sie direkt zwischen offenen Fenstern mit Live-Vorschauen."

