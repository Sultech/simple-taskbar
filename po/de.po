msgid "Use the panel’s configured transparency level"
msgstr "Verwendet die konfigurierte Transparenzstufe des Panels"

#: prefs.js:1495
msgid "Disable Blur My Shell popup blur to use this option"
msgstr ""
"Deaktivieren Sie die Popup-Unschärfe von Blur My Shell, um diese Option zu "
"nutzen"

#: prefs.js:1498
msgid "Disable Blur My Shell panel and popup blur to use this option"
msgstr ""
"Deaktivieren Sie die Panel- und Popup-Unschärfe von Blur My Shell, um diese "
"Option zu nutzen"

#: prefs.js:1501
msgid "Follow Panel Transparency"
msgstr "Panel-Transparenz folgen"

#: prefs.js:1542
msgid "Center Start Menu on Monitor"
msgstr "Startmenü auf dem Monitor zentrieren"

#: prefs.js:1543
msgid ""
"Place the menu at the true horizontal center instead of over the Start button"
msgstr ""
"Platziert das Menü in der tatsächlichen horizontalen Mitte statt über der "
"Start-Schaltfläche"

#: prefs.js:1581
msgid "Super Opens Start Menu"
msgstr "Super öffnet das Startmenü"

#: prefs.js:1582
msgid "Use Super for the Start Menu and move Overview to Super+Tab"
msgstr ""
"Verwendet Super für das Startmenü und verschiebt die Übersicht auf Super+Tab"

#: prefs.js:1594
msgid "Super+Tab Opens Start Menu"
msgstr "Super+Tab öffnet das Startmenü"

#: prefs.js:1595
msgid ""
"Use GNOME’s application-switch shortcut for the Eleven-style Start Menu "
"while it is enabled"
msgstr ""
"Verwendet die Anwendungswechsel-Tastenkombination von GNOME für das "
"Startmenü im Eleven-Stil, solange es aktiviert ist"

#: prefs.js:1622
msgid "Super+E Opens File Manager"
msgstr "Super+E öffnet den Dateimanager"

#: prefs.js:1624
msgid "Open your home folder with the system’s default file manager"
msgstr "Öffnet Ihren Home-Ordner mit dem Standard-Dateimanager des Systems"

#: prefs.js:1639
msgid "Not set"
msgstr "Nicht festgelegt"

#: prefs.js:1644
msgid "Set custom shortcut"
msgstr "Benutzerdefinierte Tastenkombination festlegen"

#: prefs.js:1649
msgid "Clear custom shortcut"
