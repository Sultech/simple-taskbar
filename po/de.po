#: prefs/preferencesWidgets.js:95
msgid "Move Up"
msgstr "Nach oben verschieben"

#: prefs/preferencesWidgets.js:100
msgid "Move Down"
msgstr "Nach unten verschieben"

#: prefs/startMenuPage.js:30
msgid "Configure the Start button position and spacing."
msgstr "Konfigurieren Sie Position und Abstand der Start-Schaltfläche."

#: prefs/startMenuPage.js:35 prefs/startMenuPage.js:193
msgid "Eleven-style Start Menu"
msgstr "Startmenü im Eleven-Stil"

#: prefs/startMenuPage.js:36
