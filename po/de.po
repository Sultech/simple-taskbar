msgid "Choose which applications appear and how they are grouped."
msgstr ""
"Wählen Sie, welche Anwendungen angezeigt werden und wie sie gruppiert sind."

#: prefs.js:153 prefs.js:618
msgid "Taskbar Behavior"
msgstr "Taskleistenverhalten"

#: prefs.js:155
msgid "Less commonly used taskbar interaction options."
msgstr "Weniger häufig verwendete Interaktionsoptionen der Taskleiste."

#: prefs.js:161
msgid "File Manager"
msgstr "Dateimanager"

#: prefs.js:163
msgid "File manager shortcuts and taskbar menu folders."
msgstr "Verknüpfungen des Dateimanagers und Ordner im Taskleistenmenü."

#: prefs.js:171
msgid "Less commonly used Start menu options."
msgstr "Weniger häufig verwendete Optionen des Startmenüs."

#: prefs.js:194
msgid "General"
msgstr "Allgemein"

#: prefs.js:199
msgid "Default GNOME Panel"
msgstr "Standard-GNOME-Panel"

#: prefs.js:200
msgid "Hide taskbar applications and use the original Dash in Overview"
msgstr ""
"Blendet Taskleisten-Anwendungen aus und verwendet das ursprüngliche Dash in "
"der Übersicht"

#: prefs.js:206
msgid "Windows XP Theme"
msgstr "Windows-XP-Thema"

#: prefs.js:207
msgid "Apply a Windows XP-inspired taskbar style"
msgstr "Einen von Windows XP inspirierten Taskleistenstil anwenden"

#: prefs.js:219
msgid "Panel Button Padding"
msgstr "Innenabstand der Panel-Schaltflächen"

#: prefs.js:221
msgid ""
"Horizontal space around panel buttons. Use -1 for automatic: Just "
"Perfection’s value when it is configured, otherwise 3 px"
msgstr ""
"Horizontaler Abstand um die Panel-Schaltflächen. Verwenden Sie -1 für "
"automatisch: der Wert von Just Perfection, wenn konfiguriert, sonst 3 px"

#: prefs.js:229
msgid "Application Icons"
msgstr "Anwendungssymbole"

#: prefs.js:230 prefs.js:535
msgid "Change the size, spacing, and placement of taskbar icons."
msgstr "Ändern Sie Größe, Abstand und Platzierung der Taskleistensymbole."

#: prefs.js:239
msgid "Icon Size"
msgstr "Symbolgröße"

#: prefs.js:241
msgid "The panel grows automatically when larger icons need more room"
msgstr ""
"Das Panel vergrößert sich automatisch, wenn größere Symbole mehr Platz "
"benötigen"

#: prefs.js:252
msgid "Icon Spacing"
msgstr "Symbolabstand"

#: prefs.js:253
msgid "Space between application buttons"
msgstr "Abstand zwischen Anwendungsschaltflächen"

#: prefs.js:263
msgid "Running Indicator Style"
msgstr "Stil der Ausführungsanzeige"

#: prefs.js:265
msgid "Choose the shape of indicators beneath running applications"
msgstr "Wählen Sie die Form der Anzeigen unter laufenden Anwendungen"

#: prefs.js:268
msgid "Rounded"
msgstr "Abgerundet"

#: prefs.js:269
msgid "Straight"
msgstr "Gerade"

#: prefs.js:274
msgid "Custom Indicator Colors"
msgstr "Benutzerdefinierte Anzeigefarben"

#: prefs.js:275
msgid "Choose colors for running application indicators"
msgstr "Wählen Sie Farben für die Anzeigen laufender Anwendungen"

#: prefs.js:292
msgid "Focused Indicator Color"
msgstr "Farbe der Anzeige für fokussierte Fenster"

#: prefs.js:300
msgid "Unfocused Indicator Color"
msgstr "Farbe der Anzeige für nicht fokussierte Fenster"

#: prefs.js:331
msgid "Icon Alignment"
msgstr "Symbolausrichtung"

#: prefs.js:333
msgid "Place application icons at the left or center"
msgstr "Platzieren Sie Anwendungssymbole links oder mittig"

#: prefs.js:340
msgid "Hide Pinned Applications"
msgstr "Angeheftete Anwendungen ausblenden"

#: prefs.js:341
msgid "Show pinned taskbar applications only while they are running"
msgstr ""
"Zeigt angeheftete Taskleisten-Anwendungen nur an, während sie ausgeführt "
"werden"

#: prefs.js:355
msgid "Use Pinned Apps as Application Launchers"
msgstr "Angeheftete Anwendungen als Starter verwenden"

#: prefs.js:357
msgid ""
"Keep pinned applications as launchers and show running applications "
"separately"
msgstr ""
"Angeheftete Anwendungen als Starter beibehalten und laufende Anwendungen "
"separat anzeigen"

#: prefs.js:372
msgid "Always"
msgstr "Immer"

#: prefs.js:373 prefs.js:377
msgid "Only When Full"
msgstr "Nur wenn voll"

#: prefs.js:374 prefs.js:378
msgid "Never"
msgstr "Nie"

#: prefs.js:385
msgid "Combine Application Buttons"
msgstr "Anwendungsschaltflächen zusammenfassen"

#: prefs.js:386
msgid "Choose when windows share one taskbar button"
msgstr "Wählen Sie, wann sich Fenster eine Taskleisten-Schaltfläche teilen"

#: prefs.js:399
msgid "Application Overflow"
msgstr "Anwendungsüberlauf"

#: prefs.js:401
msgid ""
"Show application buttons that do not fit in an overflow popup instead of "
"scrolling the taskbar"
msgstr ""
"Anwendungsschaltflächen, die nicht in das Überlaufmenü passen, anzeigen, "
"anstatt die Taskleiste zu scrollen"

#: prefs.js:420
msgid "Overflow Style"
msgstr "Überlaufstil"

#: prefs.js:422
msgid "Taskbar Flyout"
msgstr "Taskleisten-Flyout"

#: prefs.js:423
msgid "Application List"
msgstr "Anwendungsliste"

#: prefs.js:434
msgid "Hide App Labels"
msgstr "App-Beschriftungen ausblenden"

#: prefs.js:435
msgid "Show only icons on separate window buttons"
msgstr "Zeigt nur Symbole auf separaten Fensterschaltflächen"

#: prefs.js:459 prefs/windowSwitchingPage.js:52
msgid "Isolate Workspaces"
msgstr "Arbeitsflächen isolieren"

#: prefs.js:460
msgid "Show running applications from the current workspace only"
msgstr "Zeigt nur laufende Anwendungen der aktuellen Arbeitsfläche"

#: prefs.js:472 prefs/windowSwitchingPage.js:66
msgid "Isolate Monitors"
msgstr "Monitore isolieren"

#: prefs.js:473
msgid "Show running applications only on the taskbar for their monitor"
msgstr "Zeigt laufende Anwendungen nur auf der Taskleiste ihres Monitors"

#: prefs.js:485
msgid "Spread Multiple Windows"
msgstr "Mehrere Fenster verteilen"

#: prefs.js:486
msgid ""
"Click an app with multiple windows to show only its windows in Overview, "
"across all workspaces"
msgstr ""
"Klicken Sie auf eine App mit mehreren Fenstern, um in der Übersicht nur "
"deren Fenster über alle Arbeitsflächen hinweg anzuzeigen"

#: prefs.js:500
msgid "Nautilus Folder Shortcuts"
msgstr "Nautilus-Ordnerverknüpfungen"

#: prefs.js:501
msgid "Show common folders in the Files taskbar menu"
msgstr "Zeigt häufig verwendete Ordner im Dateien-Menü der Taskleiste"

#: prefs.js:534
msgid "Application icons are unavailable in Default GNOME Panel mode."
msgstr "Anwendungssymbole sind im Standard-GNOME-Panel-Modus nicht verfügbar."

#: prefs.js:537
msgid "Application options are unavailable in Default GNOME Panel mode."
msgstr "Anwendungsoptionen sind im Standard-GNOME-Panel-Modus nicht verfügbar."

#: prefs.js:623
msgid "Auto-hide Panel"
msgstr "Panel automatisch ausblenden"

#: prefs.js:624
msgid "Reveal the taskbar when the pointer reaches its screen edge"
msgstr "Zeigt die Taskleiste, wenn der Zeiger den Bildschirmrand erreicht"

#: prefs.js:636
msgid "Bottom Hot Edge"
msgstr "Unterer Aktivbereich"

#: prefs.js:637
msgid "Push the pointer against the bottom screen edge to toggle Overview"
msgstr ""
"Drücken Sie den Zeiger gegen den unteren Bildschirmrand, um die Übersicht "
"umzuschalten"

#: prefs.js:655
msgid "Activation Pressure"
msgstr "Aktivierungsdruck"

#: prefs.js:657
msgid ""
"Pixels the pointer must travel past the bottom edge before Overview activates"
msgstr ""
"Pixel, die der Zeiger über den unteren Rand hinaus zurücklegen muss, bevor "
"die Übersicht aktiviert wird"

#: prefs.js:666
msgid "Hot Edge Animation"
msgstr "Aktivbereich-Animation"

#: prefs.js:667
msgid "Show a ripple when the bottom hot edge activates"
msgstr "Zeigt einen Welleneffekt, wenn der untere Aktivbereich aktiviert wird"

#: prefs.js:689
msgid "Workspace Scroll"
msgstr "Arbeitsflächen-Scrollen"

#: prefs.js:690
msgid "Scroll over empty taskbar space to switch workspaces"
msgstr ""
"Scrollen Sie über leeren Taskleistenbereich, um die Arbeitsfläche zu wechseln"

#: prefs.js:706
msgid "Workspace Scroll Delay"
msgstr "Verzögerung beim Arbeitsflächen-Scrollen"

#: prefs.js:707
msgid "Minimum delay between workspace changes in milliseconds"
msgstr "Mindestverzögerung zwischen Arbeitsflächenwechseln in Millisekunden"

#: prefs.js:719
msgid "Middle Click Closes Applications"
msgstr "Mittelklick schließt Anwendungen"

#: prefs.js:720
msgid "Close all application windows instead of opening a new window"
msgstr "Schließt alle Anwendungsfenster, anstatt ein neues Fenster zu öffnen"

#: prefs.js:732
msgid "Panel Menus Require Click"
msgstr "Panel-Menüs erfordern Klick"

#: prefs.js:733
msgid "Switch between clock, system, and tray menus only when clicked"
msgstr "Wechselt nur bei Klick zwischen Uhr-, System- und Tray-Menüs"

#: prefs.js:745
msgid "Taskbar-aligned Notification Banners"
msgstr "An der Taskleiste ausgerichtete Benachrichtigungsbanner"

#: prefs.js:746
msgid "Follow the taskbar edge and the clock’s horizontal position"
msgstr "Folgt der Taskleistenkante und der horizontalen Position der Uhr"

#: prefs.js:784
msgid "Automatic Fallback"
msgstr "Automatischer Rückgriff"

#: prefs.js:792
msgid "Task Manager Application"
msgstr "Task-Manager-Anwendung"

#: prefs.js:793
msgid "Application opened from the taskbar context menu"
msgstr "Anwendung, die über das Kontextmenü der Taskleiste geöffnet wird"

#: prefs.js:808
msgid "Show Taskbar on All Monitors"
msgstr "Taskleiste auf allen Monitoren anzeigen"

#: prefs.js:809
msgid "Show Activities, applications, clock, and system menu on every monitor"
msgstr "Zeigt Aktivitäten, Anwendungen, Uhr und Systemmenü auf jedem Monitor"

#: prefs.js:839 prefs/preferencesDialogs.js:21
msgid "Reset"
msgstr "Zurücksetzen"

#: prefs.js:844
msgid "Reset All Settings"
msgstr "Alle Einstellungen zurücksetzen"

#: prefs.js:845
msgid "Restore defaults without changing pinned taskbar or Start Menu apps"
msgstr ""
"Stellt die Standardeinstellungen wieder her, ohne angeheftete Taskleisten- "
"oder Startmenü-Apps zu ändern"

#: prefs.js:848
msgid "Reset…"
msgstr "Zurücksetzen…"

#: prefs/panelAppearancePage.js:43
msgid "Panel Appearance"
msgstr "Panel-Erscheinungsbild"

#: prefs/panelAppearancePage.js:44
msgid "Change the taskbar height, colour scheme, and transparency."
msgstr "Ändern Sie Höhe, Farbschema und Transparenz der Taskleiste."

#: prefs/panelAppearancePage.js:53
msgid "Panel Height"
msgstr "Panel-Höhe"

#: prefs/panelAppearancePage.js:55
