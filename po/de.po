msgstr "Konfigurieren Sie das optionale Anwendungsmenü im Eleven-Stil."

#: prefs/startMenuPage.js:41
msgid "Keyboard Shortcuts"
msgstr "Tastenkombinationen"

#: prefs/startMenuPage.js:42
