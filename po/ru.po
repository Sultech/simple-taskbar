msgid "Show only pinned applications and their running windows"
msgstr "Показывать только закреплённые приложения и их открытые окна"

#: src/prefs/applicationIconsGroup.js:216
msgid "Always"
msgstr "Всегда"

#: src/prefs/applicationIconsGroup.js:217
#: src/prefs/applicationIconsGroup.js:221
msgid "Only When Full"
msgstr "Только при заполнении"

#: src/prefs/applicationIconsGroup.js:218
#: src/prefs/applicationIconsGroup.js:222
msgid "Never"
msgstr "Никогда"

#: src/prefs/applicationIconsGroup.js:229
