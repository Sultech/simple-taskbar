#: extension.js:258
msgid "Show desktop"
msgstr "Показать рабочий стол"

#: prefs.js:111
msgid "Left"
msgstr "Слева"

#: prefs.js:112
msgid "Center"
msgstr "По центру"

#: prefs.js:113
msgid "Right"
msgstr "Справа"

#: prefs.js:117
msgid "Taskbar"
msgstr "Панель задач"

#: prefs.js:123
msgid "Window Switching"
msgstr "Переключение окон"

#: prefs.js:129 prefs.js:173
msgid "Start Menu"
msgstr "Меню «Пуск»"

#: prefs.js:135
msgid "Advanced"
msgstr "Дополнительно"

#: prefs.js:141
msgid "Appearance"
msgstr "Внешний вид"

#: prefs.js:143
msgid "Less commonly used taskbar and indicator appearance options."
msgstr "Редко используемые параметры внешнего вида панели задач и индикаторов."

#: prefs.js:149
msgid "Application Behavior"
msgstr "Поведение приложений"

#: prefs.js:151 prefs.js:554
msgid "Choose which applications appear and how they are grouped."
msgstr "Выберите, какие приложения отображаются и как они группируются."

#: prefs.js:157 prefs.js:865
msgid "Taskbar Behavior"
msgstr "Поведение панели задач"

#: prefs.js:159
msgid "Less commonly used taskbar interaction options."
msgstr "Редко используемые параметры взаимодействия с панелью задач."

#: prefs.js:165
msgid "File Manager"
msgstr "Файловый менеджер"

#: prefs.js:167
msgid "File manager shortcuts and taskbar menu folders."
msgstr "Сочетания клавиш файлового менеджера и папки в меню панели задач."

#: prefs.js:175
msgid "Less commonly used Start menu options."
msgstr "Редко используемые параметры меню «Пуск»."

#: prefs.js:181
msgid "Grid Alt-Tab"
msgstr "Сетка Alt-Tab"

#: prefs.js:183
msgid "Switch directly between open windows using live previews."
msgstr "Переключайтесь между открытыми окнами с помощью живых миниатюр."

#: prefs.js:189
msgid "Enable Grid Alt-Tab"
msgstr "Включить сетку Alt-Tab"

#: prefs.js:191
msgid "Replace GNOME’s application switcher with a responsive window grid"
msgstr "Заменить переключатель приложений GNOME адаптивной сеткой окон"

#: prefs.js:208
msgid "Maximum Card Size"
msgstr "Максимальный размер карточки"

#: prefs.js:210
msgid "Largest preview height in pixels; widths follow each window’s shape"
msgstr ""
"Наибольшая высота миниатюры в пикселях; ширина зависит от пропорций окна"

#: prefs.js:218 prefs.js:475
msgid "Isolate Workspaces"
msgstr "Изолировать рабочие столы"

#: prefs.js:220
msgid "Show windows from the current workspace instead of all workspaces"
msgstr "Показывать окна только с текущего рабочего стола, а не со всех"

#: prefs.js:234 prefs.js:488
msgid "Isolate Monitors"
msgstr "Изолировать мониторы"

#: prefs.js:236
msgid "Show only windows from the monitor displaying the switcher"
msgstr ""
"Показывать только окна с монитора, на котором отображается переключатель"

#: prefs.js:250
msgid "Show on Primary Monitor"
msgstr "Показывать на основном мониторе"

#: prefs.js:252
msgid "Always display the switcher on the primary monitor"
msgstr "Всегда показывать переключатель на основном мониторе"

#: prefs.js:279 prefs.js:1087 prefs.js:1750
msgid "Start Button"
msgstr "Кнопка «Пуск»"

#: prefs.js:280
msgid "Configure the Start button position and spacing."
msgstr "Настройте положение и отступы кнопки «Пуск»."

#: prefs.js:285 prefs.js:1182
msgid "Eleven-style Start Menu"
msgstr "Eleven-style Start Menu"

#: prefs.js:286
msgid "Configure the optional Eleven-style application menu."
msgstr "Настройте дополнительное меню приложений Eleven-style."

#: prefs.js:291
msgid "Keyboard Shortcuts"
msgstr "Сочетания клавиш"

#: prefs.js:292
msgid "Configure Start menu and file manager shortcuts."
msgstr "Настройте сочетания клавиш для меню «Пуск» и файлового менеджера."

#: prefs.js:318
msgid "General"
msgstr "Общие"

#: prefs.js:323
msgid "Default GNOME Panel"
msgstr "Стандартная панель GNOME"

#: prefs.js:324
msgid "Hide taskbar applications and use the original Dash in Overview"
msgstr ""
"Скрыть приложения панели задач и использовать оригинальный Dash в обзоре"

#: prefs.js:332
msgid "Panel Button Padding"
msgstr "Отступ кнопок панели"

#: prefs.js:334
msgid ""
"Horizontal space around panel buttons. Use -1 for automatic: Just "
"Perfection’s value when it is configured, otherwise 3 px"
msgstr ""
"Горизонтальный отступ вокруг кнопок панели. Укажите -1 для автоматического "
"режима: значение Just Perfection, если оно задано, иначе 3 пикселя"

#: prefs.js:341
msgid "Application Icons"
msgstr "Значки приложений"

#: prefs.js:342 prefs.js:551
msgid "Change the size, spacing, and placement of taskbar icons."
msgstr "Измените размер, расстояние и расположение значков панели задач."

#: prefs.js:348
msgid "Icon Size"
msgstr "Размер значков"

#: prefs.js:349
msgid "The panel grows automatically when larger icons need more room"
msgstr ""
"Панель автоматически расширяется, когда крупные значки требуют больше места"

#: prefs.js:355
msgid "Icon Spacing"
msgstr "Расстояние между значками"

#: prefs.js:356
msgid "Space between application buttons"
msgstr "Расстояние между кнопками приложений"

#: prefs.js:365
msgid "Running Indicator Style"
msgstr "Стиль индикаторов запущенных приложений"

#: prefs.js:367
msgid "Choose the shape of indicators beneath running applications"
msgstr "Выберите форму индикаторов под запущенными приложениями"

#: prefs.js:370
msgid "Rounded"
msgstr "Закруглённые"

#: prefs.js:371
msgid "Straight"
msgstr "Прямые"

#: prefs.js:376
msgid "Custom Indicator Colors"
msgstr "Свои цвета индикаторов"

#: prefs.js:377
msgid "Choose colors for running application indicators"
msgstr "Выберите цвета индикаторов запущенных приложений"

#: prefs.js:394
msgid "Focused Indicator Color"
msgstr "Цвет индикатора активного приложения"

#: prefs.js:402
msgid "Unfocused Indicator Color"
msgstr "Цвет индикатора неактивного приложения"

#: prefs.js:417
msgid "Icon Alignment"
msgstr "Выравнивание значков"

#: prefs.js:418
msgid "Place application icons at the left or center"
msgstr "Расположить значки приложений слева или по центру"

#: prefs.js:423
msgid "Hide Pinned Applications"
msgstr "Скрыть закреплённые приложения"

#: prefs.js:424
msgid "Show pinned taskbar applications only while they are running"
msgstr ""
"Показывать закреплённые приложения панели задач только во время их работы"

#: prefs.js:442
msgid "Combine Application Buttons"
msgstr "Объединить кнопки приложений"

#: prefs.js:443
msgid "Choose when windows share one taskbar button"
msgstr "Выберите, когда окна объединяются в одну кнопку на панели задач"

#: prefs.js:445
msgid "Always"
msgstr "Всегда"

#: prefs.js:446
msgid "Only When Full"
msgstr "Только при заполнении"

#: prefs.js:447
msgid "Never"
msgstr "Никогда"

#: prefs.js:453
msgid "Hide App Labels"
msgstr "Скрыть подписи приложений"

#: prefs.js:454
msgid "Show only icons on separate window buttons"
msgstr "Показывать только значки на раздельных кнопках окон"

#: prefs.js:476
msgid "Show running applications from the current workspace only"
msgstr "Показывать запущенные приложения только с текущего рабочего стола"

#: prefs.js:489
msgid "Show running applications only on the taskbar for their monitor"
msgstr ""
"Показывать запущенные приложения только на панели задач соответствующего "
"монитора"

#: prefs.js:501
msgid "Spread Multiple Windows"
msgstr "Развернуть несколько окон"

#: prefs.js:502
msgid ""
"Click an app with multiple windows to show only its windows in Overview, "
"across all workspaces"
msgstr ""
"Нажмите на приложение с несколькими окнами, чтобы показать только его окна в "
"обзоре, на всех рабочих столах"

#: prefs.js:516
msgid "Nautilus Folder Shortcuts"
msgstr "Ярлыки папок Nautilus"

#: prefs.js:517
msgid "Show common folders in the Files taskbar menu"
msgstr "Показывать основные папки в меню «Файлы» на панели задач"

#: prefs.js:550
msgid "Application icons are unavailable in Default GNOME Panel mode."
msgstr "Значки приложений недоступны в режиме стандартной панели GNOME."

#: prefs.js:553
msgid "Application options are unavailable in Default GNOME Panel mode."
msgstr "Параметры приложений недоступны в режиме стандартной панели GNOME."

#: prefs.js:634
msgid "Panel Appearance"
msgstr "Внешний вид панели"

#: prefs.js:635
msgid "Change the taskbar height, colour scheme, and transparency."
msgstr "Измените высоту, цветовую схему и прозрачность панели задач."

#: prefs.js:641
msgid "Panel Height"
msgstr "Высота панели"

#: prefs.js:642
msgid "Oversized icons shrink automatically when the panel is reduced"
msgstr "Крупные значки автоматически уменьшаются при уменьшении панели"

#: prefs.js:648 prefs.js:2214
msgid "Panel Position"
msgstr "Положение панели"

#: prefs.js:649
msgid "Place the taskbar at the top or bottom of the screen"
msgstr "Расположить панель задач вверху или внизу экрана"

#: prefs.js:651
msgid "Top"
msgstr "Вверху"

#: prefs.js:652
msgid "Bottom"
msgstr "Внизу"

#: prefs.js:683
msgid "Follow System Theme"
msgstr "Следовать системной теме"

#: prefs.js:684
msgid ""
"Match the active GNOME Shell theme, independently of application colours"
msgstr "Использовать активную тему GNOME Shell независимо от цвета приложений"

#: prefs.js:700
msgid "Taskbar Theme"
msgstr "Тема панели задач"

#: prefs.js:701
msgid "Choose the colour scheme when system matching is off"
msgstr "Выберите цветовую схему, когда системное соответствие отключено"

#: prefs.js:703 prefs.js:1380
msgid "Light"
msgstr "Светлая"

#: prefs.js:704 prefs.js:1379
msgid "Dark"
msgstr "Тёмная"

#: prefs.js:714
msgid "Make the taskbar background transparent"
msgstr "Сделать фон панели задач прозрачным"

#: prefs.js:717 prefs.js:1404
msgid "Disable Blur My Shell panel blur to use this option"
msgstr ""
"Отключите размытие панели в Blur My Shell, чтобы использовать эту настройку"

#: prefs.js:720
msgid "Enable Transparency"
msgstr "Включить прозрачность"

#: prefs.js:733
msgid "0% is opaque and 100% is fully transparent"
msgstr "0% — непрозрачно, 100% — полностью прозрачно"

#: prefs.js:740
msgid "Transparency"
msgstr "Прозрачность"

#: prefs.js:765
msgid "Use a chosen color instead of the light or dark theme color"
msgstr "Использовать выбранный цвет вместо цвета светлой или тёмной темы"

#: prefs.js:768
msgid "Custom Taskbar Color"
msgstr "Свой цвет панели задач"

#: prefs.js:786
msgid "Taskbar Color"
msgstr "Цвет панели задач"

#: prefs.js:790
msgid ""
"White text uses the dark panel theme; black text uses the light panel theme"
msgstr ""
"Белый текст использует тёмную тему панели; чёрный текст — светлую тему панели"

#: prefs.js:797
msgid "Taskbar Text Color"
msgstr "Цвет текста панели задач"

#: prefs.js:800
msgid "White"
msgstr "Белый"

#: prefs.js:801
msgid "Black"
msgstr "Чёрный"

#: prefs.js:837
msgid "Show Border in Dark Mode"
msgstr "Показывать границу в тёмном режиме"

#: prefs.js:838 prefs.js:851
msgid "Display a thin border along the panel’s workspace-facing edge"
msgstr ""
"Показывать тонкую границу вдоль края панели, обращённого к рабочей области"

#: prefs.js:850
msgid "Show Border in Light Mode"
msgstr "Показывать границу в светлом режиме"

#: prefs.js:870
msgid "Auto-hide Panel"
msgstr "Автоскрытие панели"

#: prefs.js:871
msgid "Reveal the taskbar when the pointer reaches its screen edge"
msgstr "Показывать панель задач, когда указатель достигает края экрана"

#: prefs.js:883
msgid "Bottom Hot Edge"
msgstr "Активный нижний край"

#: prefs.js:884
msgid "Push the pointer against the bottom screen edge to toggle Overview"
msgstr ""
"Подведите указатель к нижнему краю экрана, чтобы открыть или закрыть обзор"

#: prefs.js:902
msgid "Activation Pressure"
msgstr "Порог активации"

#: prefs.js:904
msgid ""
"Pixels the pointer must travel past the bottom edge before Overview activates"
msgstr ""
"Сколько пикселей указатель должен пройти за нижний край экрана, прежде чем "
"откроется обзор"

#: prefs.js:913
msgid "Hot Edge Animation"
msgstr "Анимация активного края"

#: prefs.js:914
msgid "Show a ripple when the bottom hot edge activates"
msgstr "Показывать волну при срабатывании нижнего края"

#: prefs.js:936
msgid "Workspace Scroll"
msgstr "Прокрутка рабочих столов"

#: prefs.js:937
msgid "Scroll over empty taskbar space to switch workspaces"
msgstr ""
"Прокручивайте пустое пространство панели задач для переключения рабочих "
"столов"

#: prefs.js:953
msgid "Workspace Scroll Delay"
msgstr "Задержка прокрутки рабочих столов"

#: prefs.js:954
msgid "Minimum delay between workspace changes in milliseconds"
msgstr ""
"Минимальная задержка между переключениями рабочих столов в миллисекундах"

#: prefs.js:966
msgid "Middle Click Closes Applications"
msgstr "Средняя кнопка закрывает приложения"

#: prefs.js:967
msgid "Close all application windows instead of opening a new window"
msgstr "Закрывать все окна приложения вместо открытия нового окна"

#: prefs.js:979
msgid "Panel Menus Require Click"
msgstr "Меню панели открываются по щелчку"

#: prefs.js:980
msgid "Switch between clock, system, and tray menus only when clicked"
msgstr "Переключаться между меню часов, системы и трея только по щелчку"

#: prefs.js:992
msgid "Taskbar-aligned Notification Banners"
msgstr "Уведомления вдоль панели задач"

#: prefs.js:993
msgid "Follow the taskbar edge and the clock’s horizontal position"
msgstr "Следовать краю панели задач и горизонтальному положению часов"

#: prefs.js:1031
msgid "Automatic Fallback"
msgstr "Автоматический выбор"

#: prefs.js:1039
msgid "Task Manager Application"
msgstr "Приложение диспетчера задач"

#: prefs.js:1040
msgid "Application opened from the taskbar context menu"
msgstr "Приложение, открываемое из контекстного меню панели задач"

#: prefs.js:1055
msgid "Show Taskbar on All Monitors"
msgstr "Показывать панель задач на всех мониторах"

#: prefs.js:1056
msgid "Show Activities, applications, clock, and system menu on every monitor"
msgstr ""
"Показывать «Деятельность», приложения, часы и системное меню на каждом "
"мониторе"

#: prefs.js:1077
msgid "Panel Items"
msgstr "Элементы панели"

#: prefs.js:1078
msgid "Choose which optional panel items appear."
msgstr "Выберите, какие необязательные элементы отображать на панели."

#: prefs.js:1089
msgid "Place the Start button at the left edge or in the center"
msgstr "Расположить кнопку «Пуск» у левого края или по центру"

#: prefs.js:1096
msgid "Follow Application Alignment"
msgstr "Следовать выравниванию приложений"

#: prefs.js:1097
msgid "Move the Start button with the application buttons"
msgstr "Перемещать кнопку «Пуск» вместе с кнопками приложений"

#: prefs.js:1129
msgid "Start Button Padding"
msgstr "Отступ кнопки «Пуск»"

#: prefs.js:1130
msgid "Horizontal space around the Start icon in pixels"
msgstr "Горизонтальное пространство вокруг значка «Пуск» в пикселях"

#: prefs.js:1136
msgid "Custom Start Button Icon"
msgstr "Пользовательский значок кнопки «Пуск»"

#: prefs.js:1140
msgid "Use the built-in icon"
msgstr "Использовать встроенный значок"

#: prefs.js:1144 prefs.js:1683
msgid "Choose…"
msgstr "Выбрать…"

#: prefs.js:1160
msgid "Using the built-in icon"
msgstr "Используется встроенный значок"

#: prefs.js:1183
msgid "Replace the GNOME app grid with an Eleven-style menu"
msgstr "Заменить сетку приложений GNOME меню Eleven-style"

#: prefs.js:1195
msgid "Show Profile Picture"
msgstr "Показывать изображение профиля"

#: prefs.js:1196
msgid "Use your account picture in the Start Menu"
msgstr "Использовать изображение вашей учётной записи в меню «Пуск»"

#: prefs.js:1217
msgid "Power Options in Start Menu"
msgstr "Параметры питания в меню «Пуск»"

#: prefs.js:1219
msgid "Show power actions here instead of in Quick Settings"
msgstr "Показывать действия питания здесь, а не в быстрых настройках"

#: prefs.js:1241
msgid "Open All Apps by Default"
msgstr "Открывать «Все приложения» по умолчанию"

#: prefs.js:1242
msgid "Skip Pinned and open directly to applications and categories"
msgstr "Пропускать закреплённые и сразу открывать приложения и категории"

#: prefs.js:1263
msgid "Show Recommended Apps"
msgstr "Показывать рекомендуемые приложения"

#: prefs.js:1264
msgid "Display frequently used applications below pinned apps"
msgstr "Показывать часто используемые приложения под закреплёнными"

#: prefs.js:1276
msgid "Hide Pinned App Titles"
msgstr "Скрывать названия закреплённых приложений"

#: prefs.js:1278
msgid ""
"Hide the names below pinned icons and show them in a tooltip when hovered"
msgstr ""
"Скрывать названия под закреплёнными значками и показывать их во всплывающей "
"подсказке при наведении"

#: prefs.js:1312
msgid "Organize All Apps into Categories"
msgstr "Разбить все приложения по категориям"

#: prefs.js:1313
msgid "Browse applications by category in the Start menu"
msgstr "Просматривать приложения по категориям в меню «Пуск»"

#: prefs.js:1335
msgid "Show Original GNOME Button"
msgstr "Показать оригинальную кнопку GNOME"

#: prefs.js:1336
msgid ""
"Show the Applications button when the Eleven-style Start Menu is disabled"
msgstr ""
"Показывать кнопку «Приложения», когда Eleven-style Start Menu отключено"

#: prefs.js:1357
msgid "Follow Panel Theme"
msgstr "Следовать теме панели"

#: prefs.js:1358
msgid "Use the panel’s effective light or dark appearance"
msgstr "Использовать текущую светлую или тёмную тему панели"

#: prefs.js:1376
msgid "Start Menu Theme"
msgstr "Тема меню «Пуск»"

#: prefs.js:1377
msgid "Use a custom appearance or follow the GNOME Shell theme"
msgstr "Использовать пользовательский вид или следовать теме GNOME Shell"

#: prefs.js:1381
msgid "GNOME Shell"
msgstr "GNOME Shell"

#: prefs.js:1401
msgid "Use the panel’s configured transparency level"
msgstr "Использовать настроенный уровень прозрачности панели"

#: prefs.js:1407
msgid "Disable Blur My Shell popup blur to use this option"
msgstr ""
"Отключите размытие всплывающих окон в Blur My Shell, чтобы использовать эту "
"настройку"

#: prefs.js:1410
msgid "Disable Blur My Shell panel and popup blur to use this option"
msgstr ""
"Отключите размытие панели и всплывающих окон в Blur My Shell, чтобы "
"использовать эту настройку"

#: prefs.js:1413
msgid "Follow Panel Transparency"
msgstr "Следовать прозрачности панели"

#: prefs.js:1454
msgid "Center Start Menu on Monitor"
msgstr "Центрировать меню «Пуск» на мониторе"

#: prefs.js:1455
msgid ""
"Place the menu at the true horizontal center instead of over the Start button"
msgstr "Расположить меню по настоящему центру экрана, а не над кнопкой «Пуск»"

#: prefs.js:1493
msgid "Super Opens Start Menu"
msgstr "Super открывает меню «Пуск»"

#: prefs.js:1494
msgid "Use Super for the Start Menu and move Overview to Super+Tab"
msgstr "Использовать Super для меню «Пуск» и перенести обзор на Super+Tab"

#: prefs.js:1506
msgid "Super+Tab Opens Start Menu"
msgstr "Super+Tab открывает меню «Пуск»"

#: prefs.js:1507
msgid ""
"Use GNOME’s application-switch shortcut for the Eleven-style Start Menu "
"while it is enabled"
msgstr ""
"Использовать сочетание клавиш переключения приложений GNOME для Eleven-style "
