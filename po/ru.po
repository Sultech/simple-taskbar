#: showDesktopButtonController.js:116 applicationOverflowItemController.js:127
msgid "Show desktop"
msgstr "Показать рабочий стол"

#: applicationOverflowController.js:385
msgid "Application overflow"
msgstr "Переполнение приложений"

#: prefs.js:111
msgid "Left"
msgstr "Слева"

#: prefs.js:112
msgid "Center"
msgstr "По центру"

#: prefs.js:113
msgid "Right"
msgstr "Справа"

#: prefs.js:117
msgid "Taskbar"
msgstr "Панель задач"

#: prefs.js:125 prefs.js:169
msgid "Start Menu"
msgstr "Меню «Пуск»"

#: prefs.js:131
msgid "Advanced"
msgstr "Дополнительно"

#: prefs.js:137
msgid "Appearance"
msgstr "Внешний вид"

#: prefs.js:139
msgid "Less commonly used taskbar and indicator appearance options."
msgstr "Редко используемые параметры внешнего вида панели задач и индикаторов."

#: prefs.js:145
msgid "Application Behavior"
msgstr "Поведение приложений"

#: prefs.js:147 prefs.js:538
msgid "Choose which applications appear and how they are grouped."
msgstr "Выберите, какие приложения отображаются и как они группируются."

#: prefs.js:153 prefs.js:618
msgid "Taskbar Behavior"
msgstr "Поведение панели задач"

#: prefs.js:155
msgid "Less commonly used taskbar interaction options."
msgstr "Редко используемые параметры взаимодействия с панелью задач."

#: prefs.js:161
msgid "File Manager"
msgstr "Файловый менеджер"

#: prefs.js:163
msgid "File manager shortcuts and taskbar menu folders."
msgstr "Сочетания клавиш файлового менеджера и папки в меню панели задач."

#: prefs.js:171
msgid "Less commonly used Start menu options."
msgstr "Редко используемые параметры меню «Пуск»."

#: prefs.js:194
msgid "General"
msgstr "Общие"

#: prefs.js:199
msgid "Default GNOME Panel"
msgstr "Стандартная панель GNOME"

#: prefs.js:200
msgid "Hide taskbar applications and use the original Dash in Overview"
msgstr ""
"Скрыть приложения панели задач и использовать оригинальный Dash в обзоре"

#: prefs.js:206
msgid "Windows XP Theme"
msgstr "Тема Windows XP"

#: prefs.js:207
msgid "Apply a Windows XP-inspired taskbar style"
msgstr "Применить стиль панели задач в духе Windows XP"

#: prefs.js:219
msgid "Panel Button Padding"
msgstr "Отступ кнопок панели"

#: prefs.js:221
msgid ""
"Horizontal space around panel buttons. Use -1 for automatic: Just "
"Perfection’s value when it is configured, otherwise 3 px"
msgstr ""
"Горизонтальный отступ вокруг кнопок панели. Укажите -1 для автоматического "
"режима: значение Just Perfection, если оно задано, иначе 3 пикселя"

#: prefs.js:229
msgid "Application Icons"
msgstr "Значки приложений"

#: prefs.js:230 prefs.js:535
msgid "Change the size, spacing, and placement of taskbar icons."
msgstr "Измените размер, расстояние и расположение значков панели задач."

#: prefs.js:239
msgid "Icon Size"
msgstr "Размер значков"

#: prefs.js:241
msgid "The panel grows automatically when larger icons need more room"
msgstr ""
"Панель автоматически расширяется, когда крупные значки требуют больше места"

#: prefs.js:252
msgid "Icon Spacing"
msgstr "Расстояние между значками"

#: prefs.js:253
msgid "Space between application buttons"
msgstr "Расстояние между кнопками приложений"

#: prefs.js:263
msgid "Running Indicator Style"
msgstr "Стиль индикаторов запущенных приложений"

#: prefs.js:265
msgid "Choose the shape of indicators beneath running applications"
msgstr "Выберите форму индикаторов под запущенными приложениями"

#: prefs.js:268
msgid "Rounded"
msgstr "Закруглённые"

#: prefs.js:269
msgid "Straight"
msgstr "Прямые"

#: prefs.js:274
msgid "Custom Indicator Colors"
msgstr "Свои цвета индикаторов"

#: prefs.js:275
msgid "Choose colors for running application indicators"
msgstr "Выберите цвета индикаторов запущенных приложений"

#: prefs.js:292
msgid "Focused Indicator Color"
msgstr "Цвет индикатора активного приложения"

#: prefs.js:300
msgid "Unfocused Indicator Color"
msgstr "Цвет индикатора неактивного приложения"

#: prefs.js:331
msgid "Icon Alignment"
msgstr "Выравнивание значков"

#: prefs.js:333
msgid "Place application icons at the left or center"
msgstr "Расположить значки приложений слева или по центру"

#: prefs.js:340
msgid "Hide Pinned Applications"
msgstr "Скрыть закреплённые приложения"

#: prefs.js:341
msgid "Show pinned taskbar applications only while they are running"
msgstr ""
"Показывать закреплённые приложения панели задач только во время их работы"

#: prefs.js:355
msgid "Use Pinned Apps as Application Launchers"
msgstr "Использовать закреплённые приложения как средства запуска"

#: prefs.js:357
msgid ""
"Keep pinned applications as launchers and show running applications "
"separately"
msgstr ""
"Сохранять закреплённые приложения в качестве средств запуска и отдельно "
"показывать запущенные приложения"

#: prefs.js:372
msgid "Always"
msgstr "Всегда"

#: prefs.js:373 prefs.js:377
msgid "Only When Full"
msgstr "Только при заполнении"

#: prefs.js:374 prefs.js:378
msgid "Never"
msgstr "Никогда"

#: prefs.js:385
msgid "Combine Application Buttons"
msgstr "Объединить кнопки приложений"

#: prefs.js:386
msgid "Choose when windows share one taskbar button"
msgstr "Выберите, когда окна объединяются в одну кнопку на панели задач"

#: prefs.js:399
msgid "Application Overflow"
msgstr "Переполнение приложений"

#: prefs.js:401
msgid ""
"Show application buttons that do not fit in an overflow popup instead of "
"scrolling the taskbar"
msgstr ""
"Показывать кнопки приложений, для которых не хватает места, во всплывающем "
"окне переполнения вместо прокрутки панели задач"

#: prefs.js:420
msgid "Overflow Style"
msgstr "Стиль переполнения"

#: prefs.js:422
msgid "Taskbar Flyout"
msgstr "Всплывающее меню панели задач"

#: prefs.js:423
msgid "Application List"
msgstr "Список приложений"

#: prefs.js:434
msgid "Hide App Labels"
msgstr "Скрыть подписи приложений"

#: prefs.js:435
msgid "Show only icons on separate window buttons"
msgstr "Показывать только значки на раздельных кнопках окон"

#: prefs.js:459 prefs/windowSwitchingPage.js:52
msgid "Isolate Workspaces"
msgstr "Изолировать рабочие столы"

#: prefs.js:460
msgid "Show running applications from the current workspace only"
msgstr "Показывать запущенные приложения только с текущего рабочего стола"

#: prefs.js:472 prefs/windowSwitchingPage.js:66
msgid "Isolate Monitors"
msgstr "Изолировать мониторы"

#: prefs.js:473
msgid "Show running applications only on the taskbar for their monitor"
msgstr ""
"Показывать запущенные приложения только на панели задач соответствующего "
"монитора"

#: prefs.js:485
msgid "Spread Multiple Windows"
msgstr "Развернуть несколько окон"

#: prefs.js:486
msgid ""
"Click an app with multiple windows to show only its windows in Overview, "
"across all workspaces"
msgstr ""
"Нажмите на приложение с несколькими окнами, чтобы показать только его окна в "
"обзоре, на всех рабочих столах"

#: prefs.js:500
msgid "Nautilus Folder Shortcuts"
msgstr "Ярлыки папок Nautilus"

#: prefs.js:501
msgid "Show common folders in the Files taskbar menu"
msgstr "Показывать основные папки в меню «Файлы» на панели задач"

#: prefs.js:534
msgid "Application icons are unavailable in Default GNOME Panel mode."
msgstr "Значки приложений недоступны в режиме стандартной панели GNOME."

#: prefs.js:537
msgid "Application options are unavailable in Default GNOME Panel mode."
msgstr "Параметры приложений недоступны в режиме стандартной панели GNOME."

#: prefs.js:623
msgid "Auto-hide Panel"
msgstr "Автоскрытие панели"

#: prefs.js:624
msgid "Reveal the taskbar when the pointer reaches its screen edge"
msgstr "Показывать панель задач, когда указатель достигает края экрана"

#: prefs.js:636
msgid "Bottom Hot Edge"
msgstr "Активный нижний край"

#: prefs.js:637
msgid "Push the pointer against the bottom screen edge to toggle Overview"
msgstr ""
"Подведите указатель к нижнему краю экрана, чтобы открыть или закрыть обзор"

#: prefs.js:655
msgid "Activation Pressure"
msgstr "Порог активации"

#: prefs.js:657
msgid ""
"Pixels the pointer must travel past the bottom edge before Overview activates"
msgstr ""
"Сколько пикселей указатель должен пройти за нижний край экрана, прежде чем "
"откроется обзор"

#: prefs.js:666
msgid "Hot Edge Animation"
msgstr "Анимация активного края"

#: prefs.js:667
msgid "Show a ripple when the bottom hot edge activates"
msgstr "Показывать волну при срабатывании нижнего края"

#: prefs.js:689
msgid "Workspace Scroll"
msgstr "Прокрутка рабочих столов"

#: prefs.js:690
msgid "Scroll over empty taskbar space to switch workspaces"
msgstr ""
"Прокручивайте пустое пространство панели задач для переключения рабочих "
"столов"

#: prefs.js:706
msgid "Workspace Scroll Delay"
msgstr "Задержка прокрутки рабочих столов"

#: prefs.js:707
msgid "Minimum delay between workspace changes in milliseconds"
msgstr ""
"Минимальная задержка между переключениями рабочих столов в миллисекундах"

#: prefs.js:719
msgid "Middle Click Closes Applications"
msgstr "Средняя кнопка закрывает приложения"

#: prefs.js:720
msgid "Close all application windows instead of opening a new window"
msgstr "Закрывать все окна приложения вместо открытия нового окна"

#: prefs.js:732
msgid "Panel Menus Require Click"
msgstr "Меню панели открываются по щелчку"

#: prefs.js:733
msgid "Switch between clock, system, and tray menus only when clicked"
msgstr "Переключаться между меню часов, системы и трея только по щелчку"

#: prefs.js:745
msgid "Taskbar-aligned Notification Banners"
msgstr "Уведомления вдоль панели задач"

#: prefs.js:746
msgid "Follow the taskbar edge and the clock’s horizontal position"
msgstr "Следовать краю панели задач и горизонтальному положению часов"

#: prefs.js:784
msgid "Automatic Fallback"
msgstr "Автоматический выбор"

#: prefs.js:792
msgid "Task Manager Application"
msgstr "Приложение диспетчера задач"

#: prefs.js:793
msgid "Application opened from the taskbar context menu"
msgstr "Приложение, открываемое из контекстного меню панели задач"

#: prefs.js:808
msgid "Show Taskbar on All Monitors"
msgstr "Показывать панель задач на всех мониторах"

#: prefs.js:809
msgid "Show Activities, applications, clock, and system menu on every monitor"
msgstr ""
"Показывать «Деятельность», приложения, часы и системное меню на каждом "
"мониторе"

#: prefs.js:839 prefs/preferencesDialogs.js:21
msgid "Reset"
msgstr "Сбросить"

#: prefs.js:844
msgid "Reset All Settings"
msgstr "Сбросить все настройки"

#: prefs.js:845
msgid "Restore defaults without changing pinned taskbar or Start Menu apps"
msgstr ""
"Восстановить настройки по умолчанию, сохранив закреплённые приложения панели "
"задач и меню «Пуск»"

#: prefs.js:848
msgid "Reset…"
msgstr "Сбросить…"

#: prefs/panelAppearancePage.js:43
msgid "Panel Appearance"
msgstr "Внешний вид панели"

#: prefs/panelAppearancePage.js:44
msgid "Change the taskbar height, colour scheme, and transparency."
msgstr "Измените высоту, цветовую схему и прозрачность панели задач."

#: prefs/panelAppearancePage.js:53
msgid "Panel Height"
msgstr "Высота панели"

#: prefs/panelAppearancePage.js:55
msgid "Oversized icons shrink automatically when the panel is reduced"
msgstr "Крупные значки автоматически уменьшаются при уменьшении панели"

#: prefs/panelAppearancePage.js:66 prefs/preferencesWidgets.js:50
msgid "Panel Position"
msgstr "Положение панели"

#: prefs/panelAppearancePage.js:68
msgid "Place the taskbar at the top or bottom of the screen"
msgstr "Расположить панель задач вверху или внизу экрана"

#: prefs/panelAppearancePage.js:71
msgid "Top"
msgstr "Вверху"

#: prefs/panelAppearancePage.js:72
msgid "Bottom"
msgstr "Внизу"

#: prefs/panelAppearancePage.js:217
msgid "Follow System Theme"
msgstr "Следовать системной теме"

#: prefs/panelAppearancePage.js:218
msgid ""
"Match the active GNOME Shell theme, independently of application colours"
msgstr "Использовать активную тему GNOME Shell независимо от цвета приложений"

#: prefs/panelAppearancePage.js:234
msgid "Taskbar Theme"
msgstr "Тема панели задач"

#: prefs/panelAppearancePage.js:235
msgid "Choose the colour scheme when system matching is off"
msgstr "Выберите цветовую схему, когда системное соответствие отключено"

#: prefs/panelAppearancePage.js:237 prefs/startMenuPage.js:391
msgid "Light"
msgstr "Светлая"

#: prefs/panelAppearancePage.js:238 prefs/startMenuPage.js:390
msgid "Dark"
msgstr "Тёмная"

#: prefs/panelAppearancePage.js:253
msgid "Make the taskbar background transparent"
msgstr "Сделать фон панели задач прозрачным"

#: prefs/panelAppearancePage.js:256 prefs/startMenuPage.js:415
msgid "Disable Blur My Shell panel blur to use this option"
msgstr ""
"Отключите размытие панели в Blur My Shell, чтобы использовать эту настройку"

#: prefs/panelAppearancePage.js:259
msgid "Enable Transparency"
msgstr "Включить прозрачность"

#: prefs/panelAppearancePage.js:272
msgid "0% is opaque and 100% is fully transparent"
msgstr "0% — непрозрачно, 100% — полностью прозрачно"

#: prefs/panelAppearancePage.js:279
msgid "Transparency"
msgstr "Прозрачность"

#: prefs/panelAppearancePage.js:312
msgid "Use a chosen color instead of the light or dark theme color"
msgstr "Использовать выбранный цвет вместо цвета светлой или тёмной темы"

#: prefs/panelAppearancePage.js:315
msgid "Custom Taskbar Color"
msgstr "Свой цвет панели задач"

#: prefs/panelAppearancePage.js:333
msgid "Taskbar Color"
msgstr "Цвет панели задач"

#: prefs/panelAppearancePage.js:337
msgid ""
"White text uses the dark panel theme; black text uses the light panel theme"
msgstr ""
"Белый текст использует тёмную тему панели; чёрный текст — светлую тему панели"

#: prefs/panelAppearancePage.js:344
msgid "Taskbar Text Color"
msgstr "Цвет текста панели задач"

#: prefs/panelAppearancePage.js:347
msgid "White"
msgstr "Белый"

#: prefs/panelAppearancePage.js:348
msgid "Black"
msgstr "Чёрный"

#: prefs/panelAppearancePage.js:420
msgid "Show Border in Dark Mode"
msgstr "Показывать границу в тёмном режиме"

#: prefs/panelAppearancePage.js:421 prefs/panelAppearancePage.js:434
msgid "Display a thin border along the panel’s workspace-facing edge"
msgstr ""
"Показывать тонкую границу вдоль края панели, обращённого к рабочей области"

#: prefs/panelAppearancePage.js:433
msgid "Show Border in Light Mode"
msgstr "Показывать границу в светлом режиме"

#: prefs/panelItemsPage.js:26
msgid "Panel Items"
msgstr "Элементы панели"

#: prefs/panelItemsPage.js:27
msgid "Choose which optional panel items appear."
msgstr "Выберите, какие необязательные элементы отображать на панели."

#: prefs/panelItemsPage.js:32
msgid "Show Activities Button"
msgstr "Показать кнопку «Деятельность»"

#: prefs/panelItemsPage.js:33
msgid "Display GNOME’s workspace overview button on the taskbar"
msgstr "Показывать кнопку обзора рабочих столов GNOME на панели задач"

#: prefs/panelItemsPage.js:45 prefs/panelItemsPage.js:210
msgid "Show Desktop Button"
msgstr "Кнопка «Показать рабочий стол»"

#: prefs/panelItemsPage.js:46
msgid "Display a button that minimizes or restores all windows"
msgstr "Показывать кнопку, которая сворачивает или восстанавливает все окна"

#: prefs/panelItemsPage.js:60
msgid "Application Volume Mixer"
msgstr "Микшер громкости приложений"

#: prefs/panelItemsPage.js:61
msgid "Add per-application volume controls to Quick Settings"
msgstr "Добавить регуляторы громкости приложений в быстрые настройки"

#: prefs/panelItemsPage.js:73
msgid "Collect Tray Icons"
msgstr "Собирать значки уведомлений"

#: prefs/panelItemsPage.js:74 prefs/panelItemsPage.js:194
msgid "Gather application tray icons behind a panel arrow"
msgstr ""
"Собирать значки приложений из области уведомлений за стрелкой на панели"

#: prefs/panelItemsPage.js:86
msgid "Show Folder Menu"
msgstr "Показать меню папки"

#: prefs/panelItemsPage.js:87
msgid "Show a selected folder on the taskbar"
msgstr "Показывать выбранную папку на панели задач"

#: prefs/panelItemsPage.js:99
msgid "Folder Menu Location"
msgstr "Расположение меню папки"

#: prefs/panelItemsPage.js:102 prefs/startMenuPage.js:142
msgid "Choose…"
msgstr "Выбрать…"

#: prefs/panelItemsPage.js:117
msgid "No folder selected"
msgstr "Папка не выбрана"

#: prefs/panelItemsPage.js:133
msgid "Left Items"
msgstr "Элементы слева"

#: prefs/panelItemsPage.js:135
msgid "Move items only within their current panel position."
msgstr "Перемещайте элементы только внутри их текущей области панели."

#: prefs/panelItemsPage.js:139
msgid "Center Items"
msgstr "Элементы по центру"

#: prefs/panelItemsPage.js:142
msgid "Right Items"
msgstr "Элементы справа"

#: prefs/panelItemsPage.js:150
msgid "Left Box"
msgstr "Левая область"

#: prefs/panelItemsPage.js:151 prefs/panelItemsPage.js:157
#: prefs/panelItemsPage.js:163
msgid "Other GNOME Shell and extension items"
msgstr "Другие элементы GNOME Shell и расширений"

#: prefs/panelItemsPage.js:156
msgid "Center Box"
msgstr "Центральная область"

#: prefs/panelItemsPage.js:162
msgid "Right Box"
msgstr "Правая область"

#: prefs/panelItemsPage.js:169 prefs/startMenuPage.js:29
#: prefs/startMenuPage.js:72
msgid "Start Button"
msgstr "Кнопка «Пуск»"

#: prefs/panelItemsPage.js:170
msgid "Eleven-style or original GNOME Start button"
msgstr "Кнопка «Пуск» в стиле Eleven или оригинальная кнопка GNOME"

#: prefs/panelItemsPage.js:175
msgid "Activities"
msgstr "Обзор"

#: prefs/panelItemsPage.js:176
msgid "GNOME workspace overview button"
msgstr "Кнопка обзора рабочих столов GNOME"

#: prefs/panelItemsPage.js:181 startButtonController.js:610
msgid "Applications"
msgstr "Приложения"

#: prefs/panelItemsPage.js:182
msgid "Taskbar application buttons"
msgstr "Кнопки приложений на панели задач"

#: prefs/panelItemsPage.js:187
msgid "Folder Menu"
msgstr "Меню папки"

#: prefs/panelItemsPage.js:188
msgid "Selected folder shortcuts"
msgstr "Ярлыки выбранной папки"

#: prefs/panelItemsPage.js:193 trayOverflowController.js:199
msgid "Tray icons"
msgstr "Значки области уведомлений"

#: prefs/panelItemsPage.js:199
msgid "System Menu"
msgstr "Системное меню"

#: prefs/panelItemsPage.js:200
msgid "Quick Settings, volume, network, and power"
msgstr "Быстрые настройки, громкость, сеть и питание"

#: prefs/panelItemsPage.js:205
msgid "Clock"
msgstr "Часы"

#: prefs/panelItemsPage.js:211
msgid "Minimize or restore all windows"
msgstr "Свернуть или восстановить все окна"

#: prefs/preferencesDialogs.js:15
msgid "Reset all settings?"
msgstr "Сбросить все настройки?"

#: prefs/preferencesDialogs.js:17
msgid ""
"This will restore taskbar and Start Menu settings. Pinned taskbar and Start "
"Menu apps, including their order, will be kept."
msgstr ""
"Это восстановит настройки панели задач и меню «Пуск». Закреплённые "
"приложения панели задач и меню «Пуск», включая их порядок, будут сохранены."

#: prefs/preferencesDialogs.js:20 prefs/startIconChooser.js:139
msgid "Cancel"
msgstr "Отмена"

#: prefs/preferencesDialogs.js:54
msgid "Set Custom Shortcut"
msgstr "Задать пользовательское сочетание клавиш"

#: prefs/preferencesDialogs.js:67
msgid "Press a keyboard shortcut"
msgstr "Нажмите сочетание клавиш"

#: prefs/preferencesDialogs.js:68
msgid "Press Backspace to clear it, or Escape to cancel."
msgstr "Нажмите Backspace для очистки или Escape для отмены."

#: prefs/preferencesDialogs.js:108
