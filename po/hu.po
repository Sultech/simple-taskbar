#: extension.js:282
msgid "Show desktop"
msgstr "Asztal megjelenítése"

#: applicationOverflowController.js:302
msgid "Application overflow"
msgstr "Alkalmazások túlfolyása"

#: prefs.js:111
msgid "Left"
msgstr "Bal"

#: prefs.js:112
msgid "Center"
msgstr "Közép"

#: prefs.js:113
msgid "Right"
msgstr "Jobb"

#: prefs.js:117
msgid "Taskbar"
msgstr "Tálca"

#: prefs.js:123
msgid "Window Switching"
msgstr "Ablakváltás"

#: prefs.js:129 prefs.js:173
msgid "Start Menu"
msgstr "Start menü"

#: prefs.js:135
msgid "Advanced"
msgstr "Haladó"

#: prefs.js:141
msgid "Appearance"
msgstr "Megjelenés"

#: prefs.js:143
msgid "Less commonly used taskbar and indicator appearance options."
msgstr "Kevésbé használt tálca- és jelzőfény-megjelenítési beállítások."

#: prefs.js:149
msgid "Application Behavior"
msgstr "Alkalmazások viselkedése"

#: prefs.js:151 prefs.js:626
msgid "Choose which applications appear and how they are grouped."
msgstr "Válassza ki, mely alkalmazások jelenjenek meg, és hogyan legyenek csoportosítva."

#: prefs.js:157 prefs.js:953
msgid "Taskbar Behavior"
msgstr "Tálca viselkedése"

#: prefs.js:159
msgid "Less commonly used taskbar interaction options."
msgstr "Kevésbé használt tálcainterakciós beállítások."

#: prefs.js:165
msgid "File Manager"
msgstr "Fájlkezelő"

#: prefs.js:167
msgid "File manager shortcuts and taskbar menu folders."
msgstr "Fájlkezelő gyorsbillentyűk és tálcamenü mappák."

#: prefs.js:175
msgid "Less commonly used Start menu options."
msgstr "Kevésbé használt Start menü beállítások."

#: prefs.js:181
msgid "Grid Alt-Tab"
msgstr "Rácsos Alt-Tab"

#: prefs.js:183
msgid "Switch directly between open windows using live previews."
msgstr "Váltás közvetlenül a nyitott ablakok között élő előnézettel."

#: prefs.js:189
msgid "Enable Grid Alt-Tab"
msgstr "Rácsos Alt-Tab engedélyezése"

#: prefs.js:191
msgid "Replace GNOME’s application switcher with a responsive window grid"
msgstr "A GNOME alkalmazásváltójának lecserélése válaszkész ablakrácsra"

#: prefs.js:208
msgid "Maximum Card Size"
msgstr "Kártya maximális mérete"

#: prefs.js:210
msgid "Largest preview height in pixels; widths follow each window’s shape"
msgstr "A legnagyobb előnézet magassága képpontban; a szélesség az ablak alakját követi"

#: prefs.js:218 prefs.js:547
msgid "Isolate Workspaces"
msgstr "Munkaterületek elkülönítése"

#: prefs.js:220
msgid "Show windows from the current workspace instead of all workspaces"
msgstr "Ablakok megjelenítése csak az aktuális munkaterületről az összes helyett"

#: prefs.js:234 prefs.js:560
msgid "Isolate Monitors"
msgstr "Monitorok elkülönítése"

#: prefs.js:236
msgid "Show only windows from the monitor displaying the switcher"
msgstr "Csak a váltót megjelenítő monitor ablakainak megjelenítése"

#: prefs.js:250
msgid "Show on Primary Monitor"
msgstr "Megjelenítés az elsődleges monitoron"

#: prefs.js:252
msgid "Always display the switcher on the primary monitor"
msgstr "A váltó mindig az elsődleges monitoron jelenjen meg"

#: prefs.js:279 prefs.js:1175 prefs.js:1838
msgid "Start Button"
msgstr "Start gomb"

#: prefs.js:280
msgid "Configure the Start button position and spacing."
msgstr "A Start gomb pozíciójának és térközének beállítása."

#: prefs.js:285 prefs.js:1270
msgid "Eleven-style Start Menu"
msgstr "Windows 11 stílusú Start menü"

#: prefs.js:286
msgid "Configure the optional Eleven-style application menu."
msgstr "Az elhagyható Windows 11 stílusú alkalmazásmenü beállítása."

#: prefs.js:291
msgid "Keyboard Shortcuts"
msgstr "Gyorsbillentyűk"

#: prefs.js:292
msgid "Configure Start menu shortcuts."
msgstr "Start menü gyorsbillentyűk beállítása."

#: prefs.js:318
msgid "General"
msgstr "Általános"

#: prefs.js:323
msgid "Default GNOME Panel"
msgstr "Alapértelmezett GNOME panel"

#: prefs.js:324
msgid "Hide taskbar applications and use the original Dash in Overview"
msgstr "Tálcaalkalmazások elrejtése és az eredeti Dash használata az Áttekintésben"

#: prefs.js:332
msgid "Panel Button Padding"
msgstr "Panelgombok térköze"

#: prefs.js:334
msgid ""
""
"Horizontal space around panel buttons. Use -1 for automatic: Just "
"Perfection’s value when it is configured, otherwise 3 px"
msgstr "Vízszintes térköz a panelgombok körül. Használja a -1 értéket az automatikushoz: a Just Perfection értéke, ha be van állítva, egyébként 3 px"

#: prefs.js:341
msgid "Application Icons"
msgstr "Alkalmazásikonok"

#: prefs.js:342 prefs.js:623
msgid "Change the size, spacing, and placement of taskbar icons."
msgstr "A tálcaikonok méretének, térközének és elhelyezkedésének módosítása."

#: prefs.js:348
msgid "Icon Size"
msgstr "Ikonméret"

#: prefs.js:349
msgid "The panel grows automatically when larger icons need more room"
msgstr "A panel automatikusan megnő, ha a nagyobb ikonoknak több helyre van szükségük"

#: prefs.js:355
msgid "Icon Spacing"
msgstr "Ikontérköz"

#: prefs.js:356
msgid "Space between application buttons"
msgstr "Térköz az alkalmazásgombok között"

#: prefs.js:365
msgid "Running Indicator Style"
msgstr "Futó alkalmazás jelzőfény stílusa"

#: prefs.js:367
msgid "Choose the shape of indicators beneath running applications"
msgstr "Válassza ki a futó alkalmazások alatti jelzők alakját"

#: prefs.js:370
msgid "Rounded"
msgstr "Lekerekített"

#: prefs.js:371
msgid "Straight"
msgstr "Egyenes"

#: prefs.js:376
msgid "Match Icon Color"
msgstr "Egyezzen az ikon színével"

#: prefs.js:377
msgid "Use dominant color of application icon for indicator"
msgstr "Az alkalmazásikon domináns színének használata a jelzőhöz"

#: prefs.js:390
msgid "Custom Indicator Colors"
msgstr "Egyéni jelzőszínek"

#: prefs.js:391
msgid "Choose colors for running application indicators"
msgstr "Színek kiválasztása a futó alkalmazások jelzőihez"

#: prefs.js:408
msgid "Focused Indicator Color"
msgstr "Fókuszált jelző színe"

#: prefs.js:416
msgid "Unfocused Indicator Color"
msgstr "Nem fókuszált jelző színe"

#: prefs.js:437
msgid "Icon Alignment"
msgstr "Ikonok igazítása"

#: prefs.js:438
msgid "Place application icons at the left or center"
msgstr "Alkalmazásikonok elhelyezése balra vagy középre"

#: prefs.js:443
msgid "Hide Pinned Applications"
msgstr "Rögzített alkalmazások elrejtése"

#: prefs.js:444
msgid "Show pinned taskbar applications only while they are running"
msgstr "A rögzített tálcaalkalmazások megjelenítése csak futás közben"

#: prefs.js:458
msgid "Use Pinned Apps as Application Launchers"
msgstr "Rögzített alkalmazások használata indítóként"

#: prefs.js:460
msgid ""
""
"Keep pinned applications as launchers and show running applications "
"separately"
msgstr "A rögzített alkalmazások megtartása indítóként, és a futó alkalmazások külön megjelenítése"

#: prefs.js:479
msgid "Combine Application Buttons"
msgstr "Alkalmazásgombok összevonása"

#: prefs.js:480
msgid "Choose when windows share one taskbar button"
msgstr "Válassza ki, mikor osztozzanak az ablakok egyetlen tálcagombon"

#: prefs.js:482
msgid "Always"
msgstr "Mindig"

#: prefs.js:483
msgid "Only When Full"
msgstr "Csak ha megtelt"

#: prefs.js:484
msgid "Never"
msgstr "Soha"

#: prefs.js:490
msgid "Application Overflow"
msgstr "Alkalmazások túlfolyása"

#: prefs.js:492
msgid ""
""
"Show application buttons that do not fit in an overflow popup instead of "
"scrolling the taskbar"
msgstr "A nem illeszkedő alkalmazásgombok megjelenítése túlfolyó ablakban a tálca görgetése helyett"

#: prefs.js:511
msgid "Overflow Style"
msgstr "Túlfolyás stílusa"

#: prefs.js:513
msgid "Taskbar Flyout"
msgstr "Tálca felbukkanó menü"

#: prefs.js:514
msgid "Application List"
msgstr "Alkalmazáslista"

#: prefs.js:525
msgid "Hide App Labels"
msgstr "Alkalmazáscímkék elrejtése"

#: prefs.js:526
msgid "Show only icons on separate window buttons"
msgstr "Csak ikonok megjelenítése a különálló ablakgombokon"

#: prefs.js:548
msgid "Show running applications from the current workspace only"
msgstr "Futó alkalmazások megjelenítése csak az aktuális munkaterületről"

#: prefs.js:561
msgid "Show running applications only on the taskbar for their monitor"
msgstr "Futó alkalmazások megjelenítése csak a saját monitoruk tálcáján"

#: prefs.js:573
msgid "Spread Multiple Windows"
msgstr "Több ablak szétterítése"

#: prefs.js:574
msgid ""
""
"Click an app with multiple windows to show only its windows in Overview, "
"across all workspaces"
msgstr "Kattintson egy több ablakkal rendelkező alkalmazásra, hogy csak annak ablakai jelenjenek meg az Áttekintésben, az összes munkaterületen"

#: prefs.js:588
msgid "Nautilus Folder Shortcuts"
msgstr "Nautilus mappa gyorslinkek"

#: prefs.js:589
msgid "Show common folders in the Files taskbar menu"
msgstr "Gyakori mappák megjelenítése a Fájlok tálcamenüben"

#: prefs.js:622
msgid "Application icons are unavailable in Default GNOME Panel mode."
msgstr "Az alkalmazásikonok nem érhetők el az Alapértelmezett GNOME panel módban."

#: prefs.js:625
msgid "Application options are unavailable in Default GNOME Panel mode."
msgstr "Az alkalmazásbeállítások nem érhetők el az Alapértelmezett GNOME panel módban."

#: prefs.js:706
msgid "Panel Appearance"
msgstr "Panel megjelenése"

#: prefs.js:707
msgid "Change the taskbar height, colour scheme, and transparency."
msgstr "A tálca magasságának, színskálájának és átlátszóságának módosítása."

#: prefs.js:713
msgid "Panel Height"
msgstr "Panelmagasság"

#: prefs.js:714
msgid "Oversized icons shrink automatically when the panel is reduced"
msgstr "A túl nagy ikonok automatikusan csökkennek, ha a panel mérete csökken"

#: prefs.js:720 prefs.js:2302
msgid "Panel Position"
msgstr "Panel pozíciója"

#: prefs.js:721
msgid "Place the taskbar at the top or bottom of the screen"
msgstr "A tálca elhelyezése a képernyő tetején vagy alján"

#: prefs.js:723
msgid "Top"
msgstr "Fent"

#: prefs.js:724
msgid "Bottom"
msgstr "Lent"

#: prefs.js:755
msgid "Follow System Theme"
msgstr "Rendszertéma követése"

#: prefs.js:756
msgid ""
""
"Match the active GNOME Shell theme, independently of application colours"
msgstr "Igazodás az aktív GNOME Shell témához, az alkalmazások színeitől függetlenül"

#: prefs.js:772
msgid "Taskbar Theme"
msgstr "Tálca témája"

#: prefs.js:773
msgid "Choose the colour scheme when system matching is off"
msgstr "Színskála kiválasztása, ha a rendszerhez igazodás ki van kapcsolva"

#: prefs.js:775 prefs.js:1468
msgid "Light"
msgstr "Világos"

#: prefs.js:776 prefs.js:1467
msgid "Dark"
msgstr "Sötét"

#: prefs.js:791
msgid "Make the taskbar background transparent"
msgstr "Tálca hátterének átlátszóvá tétele"

#: prefs.js:794 prefs.js:1492
msgid "Disable Blur My Shell panel blur to use this option"
msgstr "A Blur My Shell panel elmosásának kikapcsolása a lehetőség használatához"

#: prefs.js:797
msgid "Enable Transparency"
msgstr "Átlátszóság engedélyezése"

#: prefs.js:810
msgid "0% is opaque and 100% is fully transparent"
msgstr "A 0% teljesen fedett, a 100% teljesen átlátszó"

#: prefs.js:817
msgid "Transparency"
msgstr "Átlátszóság"

#: prefs.js:842
msgid "Use a chosen color instead of the light or dark theme color"
msgstr "Egyéni szín használata a világos vagy sötét témaszín helyett"

#: prefs.js:845
msgid "Custom Taskbar Color"
msgstr "Egyéni tálcaszín"

#: prefs.js:863
msgid "Taskbar Color"
msgstr "Tálca színe"

#: prefs.js:867
msgid ""
""
"White text uses the dark panel theme; black text uses the light panel theme"
msgstr "A fehér szöveg a sötét paneltémát használja; a fekete szöveg a világos paneltémát"

#: prefs.js:874
msgid "Taskbar Text Color"
msgstr "Tálca szövegszíne"

#: prefs.js:877
msgid "White"
msgstr "Fehér"

#: prefs.js:878
msgid "Black"
msgstr "Fekete"

#: prefs.js:925
msgid "Show Border in Dark Mode"
msgstr "Keret megjelenítése sötét módban"

#: prefs.js:926 prefs.js:939
msgid "Display a thin border along the panel’s workspace-facing edge"
msgstr "Vékony keret megjelenítése a panel munkaterület felőli szélén"

#: prefs.js:938
msgid "Show Border in Light Mode"
msgstr "Keret megjelenítése világos módban"

#: prefs.js:958
msgid "Auto-hide Panel"
msgstr "Panel automatikus elrejtése"

#: prefs.js:959
msgid "Reveal the taskbar when the pointer reaches its screen edge"
msgstr "Tálca megjelenítése, ha az egérmutató eléri a képernyő szélét"

#: prefs.js:971
msgid "Bottom Hot Edge"
msgstr "Alsó forró él"

#: prefs.js:972
msgid "Push the pointer against the bottom screen edge to toggle Overview"
msgstr "Az egérmutató alsó képernyőszélhez nyomása az Áttekintés váltásához"

#: prefs.js:990
msgid "Activation Pressure"
msgstr "Aktiválási nyomás"

#: prefs.js:992
msgid ""
""
"Pixels the pointer must travel past the bottom edge before Overview activates"
msgstr "A képpontok száma, amennyit a mutatónak el kell mozdulnia az alsó szélén túl az Áttekintés aktiválásához"

#: prefs.js:1001
msgid "Hot Edge Animation"
msgstr "Forró él animáció"

#: prefs.js:1002
msgid "Show a ripple when the bottom hot edge activates"
msgstr "Hullámeffektus megjelenítése az alsó forró él aktiválásakor"

#: prefs.js:1024
msgid "Workspace Scroll"
msgstr "Görgetés munkaterületek között"

#: prefs.js:1025
msgid "Scroll over empty taskbar space to switch workspaces"
msgstr "Görgetés a tálca üres részén a munkaterületek közötti váltáshoz"

#: prefs.js:1041
msgid "Workspace Scroll Delay"
msgstr "Munkaterület-görgetés késleltetése"

#: prefs.js:1042
msgid "Minimum delay between workspace changes in milliseconds"
msgstr "Munkaterület-váltások közötti minimális késleltetés ezredmásodpercben"

#: prefs.js:1054
msgid "Middle Click Closes Applications"
msgstr "Középső kattintás bezárja az alkalmazásokat"

#: prefs.js:1055
msgid "Close all application windows instead of opening a new window"
msgstr "Az összes alkalmazásablak bezárása új ablak nyitása helyett"

#: prefs.js:1067
msgid "Panel Menus Require Click"
msgstr "A panelmenükhöz kattintás szükséges"

#: prefs.js:1068
msgid "Switch between clock, system, and tray menus only when clicked"
msgstr "Váltás az óra-, rendszer- és tálcamenük között csak kattintásra"

#: prefs.js:1080
msgid "Taskbar-aligned Notification Banners"
msgstr "Tálcához igazított értesítési sávok"

#: prefs.js:1081
msgid "Follow the taskbar edge and the clock’s horizontal position"
msgstr "A tálca szélének és az óra vízszintes pozíciójának követése"

#: prefs.js:1119
msgid "Automatic Fallback"
msgstr "Automatikus tartalék"

#: prefs.js:1127
msgid "Task Manager Application"
msgstr "Feladatkezelő alkalmazás"

#: prefs.js:1128
msgid "Application opened from the taskbar context menu"
msgstr "A tálca helyi menüjéből megnyitott alkalmazás"

#: prefs.js:1143
msgid "Show Taskbar on All Monitors"
msgstr "Tálca megjelenítése az összes monitoron"

#: prefs.js:1144
msgid "Show Activities, applications, clock, and system menu on every monitor"
msgstr "Tevékenységek, alkalmazások, óra és rendszermenü megjelenítése minden monitoron"

#: prefs.js:1165
msgid "Panel Items"
msgstr "Panelelemek"

#: prefs.js:1166
msgid "Choose which optional panel items appear."
msgstr "Válassza ki, mely opcionális panelelemek jelenjenek meg."

#: prefs.js:1177
msgid "Place the Start button at the left edge or in the center"
msgstr "A Start gomb elhelyezése a bal szélen vagy középen"

#: prefs.js:1184
msgid "Follow Application Alignment"
msgstr "Alkalmazások igazításának követése"

#: prefs.js:1185
msgid "Move the Start button with the application buttons"
msgstr "A Start gomb mozgatása az alkalmazásgombokkal együtt"

#: prefs.js:1217
msgid "Start Button Padding"
msgstr "Start gomb térköze"

#: prefs.js:1218
msgid "Horizontal space around the Start icon in pixels"
msgstr "Vízszintes hely a Start ikon körül képpontban"

#: prefs.js:1224
msgid "Custom Start Button Icon"
msgstr "Egyéni Start gomb ikon"

#: prefs.js:1228
msgid "Use the built-in icon"
msgstr "Beépített ikon használata"

#: prefs.js:1232 prefs.js:1771
msgid "Choose…"
msgstr "Kiválasztás…"

#: prefs.js:1248
msgid "Using the built-in icon"
msgstr "Beépített ikon használatban"

#: prefs.js:1271
msgid "Replace the GNOME app grid with an Eleven-style menu"
msgstr "A GNOME alkalmazásrács lecserélése Windows 11 stílusú menüre"

#: prefs.js:1283
msgid "Show Profile Picture"
msgstr "Profilkép megjelenítése"

#: prefs.js:1284
msgid "Use your account picture in the Start Menu"
msgstr "A fiók képének használata a Start menüben"

#: prefs.js:1305
msgid "Power Options in Start Menu"
msgstr "Tápellátási lehetőségek a Start menüben"

#: prefs.js:1307
msgid "Show power actions here instead of in Quick Settings"
msgstr "Kikapcsolási műveletek megjelenítése itt a Gyorsbeállítások helyett"

#: prefs.js:1329
msgid "Open All Apps by Default"
msgstr "Összes alkalmazás megnyitása alapértelmezés szerint"

#: prefs.js:1330
msgid "Skip Pinned and open directly to applications and categories"
msgstr "Rögzítettek kihagyása és megnyitás közvetlenül az alkalmazásokhoz és kategóriákhoz"

#: prefs.js:1351
msgid "Show Recommended Apps"
msgstr "Ajánlott alkalmazások megjelenítése"

#: prefs.js:1352
msgid "Display frequently used applications below pinned apps"
msgstr "Gyakran használt alkalmazások megjelenítése a rögzített alkalmazások alatt"

#: prefs.js:1364
msgid "Hide Pinned App Titles"
msgstr "Rögzített alkalmazások címeinek elrejtése"

#: prefs.js:1366
msgid ""
""
"Hide the names below pinned icons and show them in a tooltip when hovered"
msgstr "Név elrejtése a rögzített ikonok alatt, megjelenítés buboréksúgóban föléhúzáskor"

#: prefs.js:1400
msgid "Organize All Apps into Categories"
msgstr "Összes alkalmazás kategóriákba rendezése"

#: prefs.js:1401
msgid "Browse applications by category in the Start menu"
msgstr "Alkalmazások böngészése kategóriák szerint a Start menüben"

#: prefs.js:1423
msgid "Show Original GNOME Button"
msgstr "Eredeti GNOME gomb megjelenítése"

#: prefs.js:1424
msgid ""
""
"Show the Applications button when the Eleven-style Start Menu is disabled"
msgstr "Az Alkalmazások gomb megjelenítése, ha a Windows 11 stílusú Start menü le van tiltva"

#: prefs.js:1445
msgid "Follow Panel Theme"
msgstr "Panel téma követése"

#: prefs.js:1446
msgid "Use the panel’s effective light or dark appearance"
msgstr "A panel aktív világos vagy sötét megjelenésének használata"

#: prefs.js:1464
msgid "Start Menu Theme"
msgstr "Start menü témája"

#: prefs.js:1465
msgid "Use a custom appearance or follow the GNOME Shell theme"
msgstr "Egyéni megjelenés használata vagy a GNOME Shell téma követése"

#: prefs.js:1469
msgid "GNOME Shell"
msgstr "GNOME Shell"

#: prefs.js:1489
msgid "Use the panel’s configured transparency level"
msgstr "A panel beállított átlátszósági szintjének használata"

#: prefs.js:1495
msgid "Disable Blur My Shell popup blur to use this option"
msgstr "A Blur My Shell felbukkanó elmosásának kikapcsolása a lehetőség használatához"

#: prefs.js:1498
msgid "Disable Blur My Shell panel and popup blur to use this option"
msgstr "A Blur My Shell panel- és felbukkanó-elmosásának kikapcsolása a lehetőség használatához"

#: prefs.js:1501
msgid "Follow Panel Transparency"
msgstr "Panel átlátszóságának követése"

#: prefs.js:1542
msgid "Center Start Menu on Monitor"
msgstr "Start menü középre igazítása a monitoron"

#: prefs.js:1543
msgid ""
""
"Place the menu at the true horizontal center instead of over the Start button"
msgstr "A menü elhelyezése a tényleges vízszintes középpontban a Start gomb feletti helyett"

#: prefs.js:1581
msgid "Super Opens Start Menu"
msgstr "Super billentyű megnyitja a Start menüt"

#: prefs.js:1582
msgid "Use Super for the Start Menu and move Overview to Super+Tab"
msgstr "Super billentyű használata a Start menühöz, és az Áttekintés áthelyezése a Super+Tab-ra"

#: prefs.js:1594
msgid "Super+Tab Opens Start Menu"
msgstr "Super+Tab megnyitja a Start menüt"

#: prefs.js:1595
msgid ""
""
"Use GNOME’s application-switch shortcut for the Eleven-style Start Menu "
"while it is enabled"
