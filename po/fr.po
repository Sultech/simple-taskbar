#: extension.js:262
msgid "Show desktop"
msgstr "Afficher le bureau"

#: prefs.js:111
msgid "Left"
msgstr "Gauche"

#: prefs.js:112
msgid "Center"
msgstr "Centre"

#: prefs.js:113
msgid "Right"
msgstr "Droite"

#: prefs.js:117
msgid "Taskbar"
msgstr "Barre des tâches"

#: prefs.js:123
msgid "Window Switching"
msgstr "Sélection des fenêtres"

#: prefs.js:129 prefs.js:173
msgid "Start Menu"
msgstr "Menu démarrer"

#: prefs.js:135
msgid "Advanced"
msgstr "Avancé"

#: prefs.js:141
msgid "Appearance"
msgstr "Apparence"

#: prefs.js:143
msgid "Less commonly used taskbar and indicator appearance options."
msgstr ""
"Options d’apparence de la barre des tâches et des indicateurs utilisées "
"moins souvent."

#: prefs.js:149
msgid "Application Behavior"
msgstr "Comportement des applications"

#: prefs.js:151 prefs.js:554
msgid "Choose which applications appear and how they are grouped."
msgstr ""
"Choisir quelles applications s’affichent et comment elles sont regroupées."

#: prefs.js:157 prefs.js:881
msgid "Taskbar Behavior"
msgstr "Comportement de la barre des tâches"

#: prefs.js:159
msgid "Less commonly used taskbar interaction options."
msgstr ""
"Options d’interaction avec la barre des tâches utilisées moins souvent."

#: prefs.js:165
msgid "File Manager"
msgstr "Gestionnaire de fichiers"

#: prefs.js:167
msgid "File manager shortcuts and taskbar menu folders."
msgstr ""
"Raccourcis du gestionnaire de fichiers et dossiers des menus de la barre des "
"tâches."

#: prefs.js:175
msgid "Less commonly used Start menu options."
msgstr "Options du menu démarrer utilisées moins souvent."

#: prefs.js:181
msgid "Grid Alt-Tab"
msgstr "Grille Alt-Tab"

#: prefs.js:183
msgid "Switch directly between open windows using live previews."
msgstr ""
"Basculer directement entre les fenêtres ouvertes en utilisant des aperçus "
"dynamiques."

#: prefs.js:189
msgid "Enable Grid Alt-Tab"
msgstr "Activer la grille Alt-Tab"

#: prefs.js:191
msgid "Replace GNOME’s application switcher with a responsive window grid"
msgstr ""
"Remplacer le sélecteur d’applications de GNOME par une grille de fenêtres "
"dynamique"

#: prefs.js:208
msgid "Maximum Card Size"
msgstr "Taille maximale de la carte"

#: prefs.js:210
msgid "Largest preview height in pixels; widths follow each window’s shape"
msgstr ""
"Hauteur maximale de l’aperçu en pixels; la largeur suit la forme de chaque "
"fenêtre"

#: prefs.js:218 prefs.js:475
msgid "Isolate Workspaces"
msgstr "Isoler les espaces de travail"

#: prefs.js:220
msgid "Show windows from the current workspace instead of all workspaces"
msgstr ""
"Afficher les fenêtres de l’espace de travail actuel au lieu de tous les "
"espaces de travail"

#: prefs.js:234 prefs.js:488
msgid "Isolate Monitors"
msgstr "Isoler les moniteurs"

#: prefs.js:236
msgid "Show only windows from the monitor displaying the switcher"
msgstr "Montrer seulement les fenêtres du moniteur qui affiche le sélecteur"

#: prefs.js:250
msgid "Show on Primary Monitor"
msgstr "Afficher sur le moniteur principal"

#: prefs.js:252
msgid "Always display the switcher on the primary monitor"
msgstr "Toujours afficher le sélecteur sur l’écran principal"

#: prefs.js:279 prefs.js:1103 prefs.js:1766
msgid "Start Button"
msgstr "Bouton démarrer"

#: prefs.js:280
msgid "Configure the Start button position and spacing."
msgstr "Configurer l’emplacement du bouton démarrer et son espacement."

#: prefs.js:285 prefs.js:1198
msgid "Eleven-style Start Menu"
msgstr "Menu démarrer de style Eleven"

#: prefs.js:286
msgid "Configure the optional Eleven-style application menu."
msgstr "Configurer le menu d’application de style Eleven optionnel."

#: prefs.js:291
msgid "Keyboard Shortcuts"
msgstr "Raccourcis clavier"

#: prefs.js:292
msgid "Configure Start menu shortcuts."
msgstr "Configurer les raccourcis du menu démarrer."

#: prefs.js:318
msgid "General"
msgstr "Général"

#: prefs.js:323
msgid "Default GNOME Panel"
msgstr "Panneau GNOME par défaut"

#: prefs.js:324
msgid "Hide taskbar applications and use the original Dash in Overview"
msgstr ""
"Masquer les applications de la barre des tâches et utiliser le dock "
"d’origine dans l’aperçu"

#: prefs.js:332
msgid "Panel Button Padding"
msgstr "Remplissage du bouton du panneau"

#: prefs.js:334
msgid ""
"Horizontal space around panel buttons. Use -1 for automatic: Just "
"Perfection’s value when it is configured, otherwise 3 px"
msgstr ""
"Espace horizontal autour des boutons du panneau. Utilisez -1 pour le mode "
"automatique : la valeur de Just Perfection lorsqu’elle est configurée, sinon "
"3 px"

#: prefs.js:341
msgid "Application Icons"
msgstr "Icônes d’applications"

#: prefs.js:342 prefs.js:551
msgid "Change the size, spacing, and placement of taskbar icons."
msgstr ""
"Changer la taille, l’espacement et le placement des icônes de la barre des "
"tâches."

#: prefs.js:348
msgid "Icon Size"
msgstr "Taille des icônes"

#: prefs.js:349
msgid "The panel grows automatically when larger icons need more room"
msgstr ""
"Le panneau grandit automatiquement lorsque des icônes de grande taille "
"nécessitent plus d’espace"

#: prefs.js:355
msgid "Icon Spacing"
msgstr "Espacement des icônes"

#: prefs.js:356
msgid "Space between application buttons"
msgstr "Espace entre les boutons d’applications"

#: prefs.js:365
msgid "Running Indicator Style"
msgstr "Style de l’indicateur des applications en cours d’exécution"

#: prefs.js:367
msgid "Choose the shape of indicators beneath running applications"
msgstr ""
"Sélectionner la forme des indicateurs sous les applications en cours "
"d’exécution"

#: prefs.js:370
msgid "Rounded"
msgstr "Arrondi"

#: prefs.js:371
msgid "Straight"
msgstr "Droit"

#: prefs.js:376
msgid "Custom Indicator Colors"
msgstr "Couleurs personnalisées de l’indicateur"

#: prefs.js:377
msgid "Choose colors for running application indicators"
msgstr ""
"Sélectionner les couleurs pour les indicateurs des applications en cours "
"d’exécution"

#: prefs.js:394
msgid "Focused Indicator Color"
msgstr "Couleur de l’indicateur de la fenêtre sélectionnée"

#: prefs.js:402
msgid "Unfocused Indicator Color"
msgstr "Couleur de l’indicateur de la fenêtre non sélectionnée"

#: prefs.js:417
msgid "Icon Alignment"
msgstr "Alignement des icônes"

#: prefs.js:418
msgid "Place application icons at the left or center"
msgstr "Placer les icônes d’applications à gauche ou au centre"

#: prefs.js:423
msgid "Hide Pinned Applications"
msgstr "Masquer les applications épinglées"

#: prefs.js:424
msgid "Show pinned taskbar applications only while they are running"
msgstr ""
"Afficher les applications épinglées seulement lorsqu’elles sont en cours "
"d’exécution"

#: prefs.js:442
msgid "Combine Application Buttons"
msgstr "Combiner les boutons d’applications"

#: prefs.js:443
msgid "Choose when windows share one taskbar button"
msgstr "Choisir quand les fenêtres se partagent un bouton de barre des tâches"

#: prefs.js:445
msgid "Always"
msgstr "Toujours"

#: prefs.js:446
msgid "Only When Full"
msgstr "Seulement quand rempli"

#: prefs.js:447
msgid "Never"
msgstr "Jamais"

#: prefs.js:453
msgid "Hide App Labels"
msgstr "Masquer les étiquettes d’applications"

#: prefs.js:454
msgid "Show only icons on separate window buttons"
msgstr "Afficher seulement les icônes sur des boutons séparés de fenêtres"

#: prefs.js:476
msgid "Show running applications from the current workspace only"
msgstr ""
"Afficher uniquement les applications en cours d’exécution de l’actuel espace "
"de travail"

#: prefs.js:489
msgid "Show running applications only on the taskbar for their monitor"
msgstr ""
"Afficher les applications en cours d’exécution seulement sur la barre des "
"tâches de leur moniteur"

#: prefs.js:501
msgid "Spread Multiple Windows"
msgstr "Disperser les multiples fenêtres"

#: prefs.js:502
msgid ""
"Click an app with multiple windows to show only its windows in Overview, "
"across all workspaces"
msgstr ""
"Cliquer sur une application avec de multiple fenêtres afin de montrer "
"uniquement ses fenêtres en mode aperçu, sur tous les espaces de travail"

#: prefs.js:516
msgid "Nautilus Folder Shortcuts"
msgstr "Raccourcis de dossiers de Nautilus"

#: prefs.js:517
msgid "Show common folders in the Files taskbar menu"
msgstr ""
"Afficher les dossiers communs dans le menu de la barre des tâches de Fichiers"

#: prefs.js:550
msgid "Application icons are unavailable in Default GNOME Panel mode."
msgstr ""
"Les icônes d’applications ne sont pas disponibles dans le mode par défaut du "
"panneau GNOME."

#: prefs.js:553
msgid "Application options are unavailable in Default GNOME Panel mode."
msgstr ""
"Les options d’applications sont indisponibles en mode Panneau GNOME par "
"défaut."

#: prefs.js:634
msgid "Panel Appearance"
msgstr "Apparence du panneau"

#: prefs.js:635
msgid "Change the taskbar height, colour scheme, and transparency."
msgstr ""
"Changer la hauteur de la barre des tâches, le schéma des couleurs et la "
"transparence."

#: prefs.js:641
msgid "Panel Height"
msgstr "Hauteur du panneau"

#: prefs.js:642
msgid "Oversized icons shrink automatically when the panel is reduced"
msgstr ""
"Les icônes trop grandes sont rétrécies automatiquement lorsque la taille du "
"panneau est réduite"

#: prefs.js:648 prefs.js:2230
msgid "Panel Position"
msgstr "Emplacement du panneau"

#: prefs.js:649
msgid "Place the taskbar at the top or bottom of the screen"
msgstr "Placer la barre des tâches en haut ou en bas de l’écran"

#: prefs.js:651
msgid "Top"
msgstr "En haut"

#: prefs.js:652
msgid "Bottom"
msgstr "En bas"

#: prefs.js:683
msgid "Follow System Theme"
msgstr "Suivre le thème du système"

#: prefs.js:684
msgid ""
"Match the active GNOME Shell theme, independently of application colours"
msgstr ""
"S’accorder au thème actif de GNOME Shell, indépendamment des couleurs des "
"applications"

#: prefs.js:700
msgid "Taskbar Theme"
msgstr "Thème de la barre des tâches"

#: prefs.js:701
msgid "Choose the colour scheme when system matching is off"
msgstr ""
"Sélectionner le schéma de couleurs lorsqu’il n’est pas accordé au système"

#: prefs.js:703 prefs.js:1396
msgid "Light"
msgstr "Clair"

#: prefs.js:704 prefs.js:1395
msgid "Dark"
msgstr "Sombre"

#: prefs.js:719
msgid "Make the taskbar background transparent"
msgstr "Rendre l’arrière-plan de la barre des tâches transparent"

#: prefs.js:722 prefs.js:1420
msgid "Disable Blur My Shell panel blur to use this option"
msgstr ""
"Désactiver le flou du panneau de Blur My Shell pour utiliser cette option"

#: prefs.js:725
msgid "Enable Transparency"
msgstr "Activer la transparence"

#: prefs.js:738
msgid "0% is opaque and 100% is fully transparent"
msgstr "0% est opaque et 100% est complètement transparent"

#: prefs.js:745
msgid "Transparency"
msgstr "Transparence"

#: prefs.js:770
msgid "Use a chosen color instead of the light or dark theme color"
msgstr "Utiliser une couleur choisie au lieu de celle du thème clair ou sombre"

#: prefs.js:773
msgid "Custom Taskbar Color"
msgstr "Couleur personnalisée de la barre des tâches"

#: prefs.js:791
msgid "Taskbar Color"
msgstr "Couleur de la barre des tâches"

#: prefs.js:795
msgid ""
"White text uses the dark panel theme; black text uses the light panel theme"
msgstr ""
"Le texte blanc utilise le thème sombre du panneau ; le texte noir utilise le "
"thème clair du panneau"

#: prefs.js:802
msgid "Taskbar Text Color"
msgstr "Couleur du texte de la barre des tâches"

#: prefs.js:805
msgid "White"
msgstr "Blanc"

#: prefs.js:806
msgid "Black"
msgstr "Noir"

#: prefs.js:853
msgid "Show Border in Dark Mode"
msgstr "Afficher la bordure en mode sombre"

#: prefs.js:854 prefs.js:867
msgid "Display a thin border along the panel’s workspace-facing edge"
msgstr ""
"Afficher une fine bordure le long du bord du panneau faisant face à l’espace "
"de travail"

#: prefs.js:866
msgid "Show Border in Light Mode"
msgstr "Afficher la bordure en mode clair"

#: prefs.js:886
msgid "Auto-hide Panel"
msgstr "Masquer automatiquement le panneau"

#: prefs.js:887
msgid "Reveal the taskbar when the pointer reaches its screen edge"
msgstr ""
"Afficher la barre des tâches lorsque le curseur atteint le bord de l’écran"

#: prefs.js:899
msgid "Bottom Hot Edge"
msgstr "Bord chaud en bas"

#: prefs.js:900
msgid "Push the pointer against the bottom screen edge to toggle Overview"
msgstr ""
"Appuyer le curseur contre le bord inférieur de l’écran pour déclencher "
"l’aperçu"

#: prefs.js:918
msgid "Activation Pressure"
msgstr "Pression d’activation"

#: prefs.js:920
msgid ""
"Pixels the pointer must travel past the bottom edge before Overview activates"
msgstr ""
"Nombre de pixels que le curseur doit parcourir au-delà du bord inférieur "
"avant que l’aperçu ne s’active"

#: prefs.js:929
msgid "Hot Edge Animation"
msgstr "Animation du bord chaud"

#: prefs.js:930
msgid "Show a ripple when the bottom hot edge activates"
msgstr "Afficher une ondulation à l'activation du bord chaud"

#: prefs.js:952
msgid "Workspace Scroll"
msgstr "Défilement des espaces de travail"

#: prefs.js:953
msgid "Scroll over empty taskbar space to switch workspaces"
msgstr ""
"Défiler sur un espace vide de la barre des tâches afin de basculer entre les "
"espaces de travail"

#: prefs.js:969
msgid "Workspace Scroll Delay"
msgstr "Délai du défilement des espaces de travail"

#: prefs.js:970
msgid "Minimum delay between workspace changes in milliseconds"
msgstr ""
"Délai minimum entre les changements d’espace de travail en millisecondes"

#: prefs.js:982
msgid "Middle Click Closes Applications"
msgstr "Le clic du milieu ferme les applications"

#: prefs.js:983
msgid "Close all application windows instead of opening a new window"
msgstr ""
"Fermer toutes les fenêtres d'une application au lieu d'ouvrir une nouvelle "
"fenêtre"

#: prefs.js:995
msgid "Panel Menus Require Click"
msgstr "Les menus du panneau nécessitent un clic"

#: prefs.js:996
msgid "Switch between clock, system, and tray menus only when clicked"
msgstr ""
"Basculer entre les menus d’horloge, système et tiroir uniquement en cas de "
"clic"

#: prefs.js:1008
msgid "Taskbar-aligned Notification Banners"
msgstr "Bannières de notifications alignées à la barre des tâches."

#: prefs.js:1009
msgid "Follow the taskbar edge and the clock’s horizontal position"
msgstr ""
"Suivre le bord de la barre des tâches et le positionnement horizontal de "
"l’horloge"

#: prefs.js:1047
msgid "Automatic Fallback"
msgstr "Repli automatique"

#: prefs.js:1055
msgid "Task Manager Application"
msgstr "Application de gestionnaire de tâches"

#: prefs.js:1056
msgid "Application opened from the taskbar context menu"
msgstr "Application ouverte par le menu contextuel de la barre des tâches"

#: prefs.js:1071
msgid "Show Taskbar on All Monitors"
msgstr "Afficher la barre de tâches sur tous les moniteurs"

#: prefs.js:1072
msgid "Show Activities, applications, clock, and system menu on every monitor"
msgstr ""
"Afficher les activités, les applications, l’horloge et le menu système sur "
"chaque moniteur"

#: prefs.js:1093
msgid "Panel Items"
msgstr "Éléments du panneau"

#: prefs.js:1094
msgid "Choose which optional panel items appear."
msgstr "Sélectionner les éléments optionnels du panneau à afficher."

#: prefs.js:1105
msgid "Place the Start button at the left edge or in the center"
msgstr "Placer le bouton démarrer au bord gauche ou au centre"

#: prefs.js:1112
msgid "Follow Application Alignment"
msgstr "Suivre l’alignement de l’application"

#: prefs.js:1113
msgid "Move the Start button with the application buttons"
msgstr "Déplacer le bouton démarrer avec les boutons d’applications"

#: prefs.js:1145
msgid "Start Button Padding"
msgstr "Remplissage du bouton démarrer"

#: prefs.js:1146
msgid "Horizontal space around the Start icon in pixels"
msgstr "Espace horizontal autour du bouton démarrer en pixels"

#: prefs.js:1152
msgid "Custom Start Button Icon"
msgstr "Icône personnalisée du bouton démarrer"

#: prefs.js:1156
msgid "Use the built-in icon"
msgstr "Utiliser l’icône par défaut"

#: prefs.js:1160 prefs.js:1699
msgid "Choose…"
msgstr "Sélectionner…"

#: prefs.js:1176
msgid "Using the built-in icon"
msgstr "Utilise l’icône par défaut"

#: prefs.js:1199
msgid "Replace the GNOME app grid with an Eleven-style menu"
msgstr "Remplacer la grille d’applications GNOME par un menu de style Eleven"

#: prefs.js:1211
msgid "Show Profile Picture"
msgstr "Afficher l’image du profil"

#: prefs.js:1212
msgid "Use your account picture in the Start Menu"
msgstr "Utilise l’image de votre compte dans le menu démarrer"

#: prefs.js:1233
msgid "Power Options in Start Menu"
msgstr "Options d’alimentation dans le menu démarrer"

#: prefs.js:1235
msgid "Show power actions here instead of in Quick Settings"
msgstr ""
"Afficher les options d’alimentation ici plutôt que dans le menu des "
"paramètres rapides"

#: prefs.js:1257
msgid "Open All Apps by Default"
msgstr "Ouvrir toutes les applications par défaut"

#: prefs.js:1258
msgid "Skip Pinned and open directly to applications and categories"
msgstr ""
"Passer les applications épinglées et afficher directement les applications "
"et catégories"

#: prefs.js:1279
msgid "Show Recommended Apps"
msgstr "Afficher les applications recommandées"

#: prefs.js:1280
msgid "Display frequently used applications below pinned apps"
msgstr ""
"Afficher les applications fréquemment utilisées sous les applications "
"épinglées"

#: prefs.js:1292
msgid "Hide Pinned App Titles"
msgstr "Masquer les titres des applications épinglées"

#: prefs.js:1294
msgid ""
"Hide the names below pinned icons and show them in a tooltip when hovered"
msgstr ""
"Masquer les noms sous les icônes épinglées et les afficher dans une "
"infobulle au survol"

#: prefs.js:1328
msgid "Organize All Apps into Categories"
msgstr "Organiser par catégorie toutes les applications"

#: prefs.js:1329
msgid "Browse applications by category in the Start menu"
msgstr "Parcourir les applications par catégorie dans le menu démarrer"

#: prefs.js:1351
msgid "Show Original GNOME Button"
msgstr "Afficher le bouton GNOME d’origine"

#: prefs.js:1352
msgid ""
"Show the Applications button when the Eleven-style Start Menu is disabled"
msgstr ""
"Afficher le bouton d’applications lorsque le menu de style Eleven est "
"désactivé"

#: prefs.js:1373
msgid "Follow Panel Theme"
msgstr "Suivre le thème du panneau"

#: prefs.js:1374
msgid "Use the panel’s effective light or dark appearance"
msgstr "Utiliser l’apparence claire ou sombre du panneau"

#: prefs.js:1392
msgid "Start Menu Theme"
msgstr "Thème du menu démarrer"

#: prefs.js:1393
msgid "Use a custom appearance or follow the GNOME Shell theme"
msgstr "Utiliser une apparence personnalisée ou suivre le thème de GNOME Shell"

#: prefs.js:1397
msgid "GNOME Shell"
msgstr "GNOME Shell"

#: prefs.js:1417
msgid "Use the panel’s configured transparency level"
msgstr "Utiliser le niveau de transparence configuré du panneau"

#: prefs.js:1423
msgid "Disable Blur My Shell popup blur to use this option"
msgstr ""
"Désactiver le flou des fenêtres contextuelles de Blur My Shell pour utiliser "
"cette option"

#: prefs.js:1426
msgid "Disable Blur My Shell panel and popup blur to use this option"
msgstr ""
"Désactiver les flous du panneau et des fenêtres contextuelles de Blur My "
"Shell pour utiliser cette option"

#: prefs.js:1429
msgid "Follow Panel Transparency"
msgstr "Suivre la transparence du panneau"

#: prefs.js:1470
msgid "Center Start Menu on Monitor"
msgstr "Centrer le menu démarrer sur le moniteur"

#: prefs.js:1471
msgid ""
"Place the menu at the true horizontal center instead of over the Start button"
msgstr ""
"Placer le menu au véritable centre horizontal plutôt qu’au-dessus du bouton "
"démarrer"

#: prefs.js:1509
msgid "Super Opens Start Menu"
msgstr "Super ouvre le menu démarrer"

#: prefs.js:1510
msgid "Use Super for the Start Menu and move Overview to Super+Tab"
msgstr "Utiliser Super pour le menu démarrer et Super+Tab pour l’aperçu"

#: prefs.js:1522
msgid "Super+Tab Opens Start Menu"
msgstr "Super+Tab ouvre le menu démarrer"

#: prefs.js:1523
msgid ""
"Use GNOME’s application-switch shortcut for the Eleven-style Start Menu "
"while it is enabled"
msgstr ""
"Utiliser le raccourci du sélecteur d’applications GNOME pour le menu "
"démarrer de style Eleven lorsque ceci est activé"

#: prefs.js:1550
msgid "Super+E Opens File Manager"
msgstr "Super+E ouvre le gestionnaire de fichiers"

#: prefs.js:1552
msgid "Open your home folder with the system’s default file manager"
msgstr ""
"Ouvrir votre dossier personnel avec le gestionnaire de fichiers par défaut "
"du système"

#: prefs.js:1567
msgid "Not set"
msgstr "Non défini"

#: prefs.js:1572
msgid "Set custom shortcut"
msgstr "Définir un raccourci personnalisé"

#: prefs.js:1577
msgid "Clear custom shortcut"
msgstr "Supprimer le raccourci personnalisé"

#: prefs.js:1581
msgid "Custom Start Menu Shortcut"
msgstr "Raccourci personnalisé du menu démarrer"

#: prefs.js:1600
msgid "Turn off the Super shortcut to use a custom shortcut"
msgstr ""
"Désactiver le raccourci de la touche Super pour utiliser un raccourci "
"personnalisé"

#: prefs.js:1603
msgid "Turn off Super+Tab to use a custom shortcut"
msgstr ""
"Désactiver le raccourci des touches Super+Tab pour utiliser un raccourci "
"personnalisé"

#: prefs.js:1606
msgid "Choose any unused keyboard shortcut; none is assigned by default"
msgstr ""
"Sélectionner n’importe quel raccourci clavier inutilisé; aucun n’est assigné "
"par défaut"

#: prefs.js:1629
msgid "Show Activities Button"
msgstr "Afficher le bouton des activités"

#: prefs.js:1630
msgid "Display GNOME’s workspace overview button on the taskbar"
msgstr ""
"Afficher le bouton de l’aperçu des espaces de travail GNOME sur la barre des "
"tâches"

#: prefs.js:1642 prefs.js:1807
msgid "Show Desktop Button"
msgstr "Bouton afficher le bureau"

#: prefs.js:1643
msgid "Display a button that minimizes or restores all windows"
msgstr "Afficher un bouton qui réduit ou restaure toutes les fenêtres"

#: prefs.js:1657
msgid "Application Volume Mixer"
msgstr "Mélangeur de volume des applications"

#: prefs.js:1658
msgid "Add per-application volume controls to Quick Settings"
msgstr "Ajoute le contrôle du volume par application aux paramètres rapides"

#: prefs.js:1670
msgid "Collect Tray Icons"
msgstr "Regrouper les icônes de notification"

#: prefs.js:1671 prefs.js:1791
msgid "Gather application tray icons behind a panel arrow"
