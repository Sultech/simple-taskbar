#: extension.js:262
msgid "Show desktop"
msgstr "Mostra desktop"

#: prefs.js:111
msgid "Left"
msgstr "Sinistra"

#: prefs.js:112
msgid "Center"
msgstr "Centro"

#: prefs.js:113
msgid "Right"
msgstr "Destra"

#: prefs.js:117
msgid "Taskbar"
msgstr "Barra delle applicazioni"

#: prefs.js:123
msgid "Window Switching"
msgstr "Cambio finestra"

#: prefs.js:129 prefs.js:173
msgid "Start Menu"
msgstr "Menu Start"

#: prefs.js:135
msgid "Advanced"
msgstr "Avanzate"

#: prefs.js:141
msgid "Appearance"
msgstr "Aspetto"

#: prefs.js:143
msgid "Less commonly used taskbar and indicator appearance options."
msgstr ""
"Opzioni di aspetto della barra delle applicazioni e degli indicatori usate "
"meno di frequente."

#: prefs.js:149
msgid "Application Behavior"
msgstr "Comportamento delle applicazioni"

#: prefs.js:151 prefs.js:571
msgid "Choose which applications appear and how they are grouped."
msgstr ""
"Scegli quali applicazioni vengono visualizzate e come sono raggruppate."

#: prefs.js:157 prefs.js:898
msgid "Taskbar Behavior"
msgstr "Comportamento della barra delle applicazioni"

#: prefs.js:159
msgid "Less commonly used taskbar interaction options."
msgstr ""
"Opzioni di interazione della barra delle applicazioni usate meno di "
"frequente."

#: prefs.js:165
msgid "File Manager"
msgstr "Gestore file"

#: prefs.js:167
msgid "File manager shortcuts and taskbar menu folders."
msgstr ""
"Scorciatoie del gestore file e cartelle del menu della barra delle "
"applicazioni."

#: prefs.js:175
msgid "Less commonly used Start menu options."
msgstr "Opzioni del menu Start usate meno di frequente."

#: prefs.js:181
msgid "Grid Alt-Tab"
msgstr "Alt-Tab a griglia"

#: prefs.js:183
msgid "Switch directly between open windows using live previews."
msgstr "Passa direttamente tra le finestre aperte usando anteprime dal vivo."

#: prefs.js:189
msgid "Enable Grid Alt-Tab"
msgstr "Abilita Alt-Tab a griglia"

#: prefs.js:191
msgid "Replace GNOME’s application switcher with a responsive window grid"
msgstr ""
"Sostituisce il selettore di applicazioni di GNOME con una griglia di "
"finestre responsiva"

#: prefs.js:208
msgid "Maximum Card Size"
msgstr "Dimensione massima delle schede"

#: prefs.js:210
msgid "Largest preview height in pixels; widths follow each window’s shape"
msgstr ""
"Altezza massima dell’anteprima in pixel; la larghezza segue la forma di "
"ciascuna finestra"

#: prefs.js:218 prefs.js:492
msgid "Isolate Workspaces"
msgstr "Isola gli spazi di lavoro"

#: prefs.js:220
msgid "Show windows from the current workspace instead of all workspaces"
msgstr ""
"Mostra le finestre dello spazio di lavoro corrente invece di tutti gli spazi "
"di lavoro"

#: prefs.js:234 prefs.js:505
msgid "Isolate Monitors"
msgstr "Isola i monitor"

#: prefs.js:236
msgid "Show only windows from the monitor displaying the switcher"
msgstr "Mostra solo le finestre del monitor che visualizza il selettore"

#: prefs.js:250
msgid "Show on Primary Monitor"
msgstr "Mostra sul monitor principale"

#: prefs.js:252
msgid "Always display the switcher on the primary monitor"
msgstr "Mostra sempre il selettore sul monitor principale"

#: prefs.js:279 prefs.js:1120 prefs.js:1783
msgid "Start Button"
msgstr "Pulsante Start"

#: prefs.js:280
msgid "Configure the Start button position and spacing."
msgstr "Configura la posizione e la spaziatura del pulsante Start."

#: prefs.js:285 prefs.js:1215
msgid "Eleven-style Start Menu"
msgstr "Menu Start in stile Eleven"

#: prefs.js:286
msgid "Configure the optional Eleven-style application menu."
msgstr "Configura il menu applicazioni opzionale in stile Eleven."

#: prefs.js:291
msgid "Keyboard Shortcuts"
msgstr "Scorciatoie da tastiera"

#: prefs.js:292
msgid "Configure Start menu shortcuts."
msgstr "Configura le scorciatoie del menu Start."

#: prefs.js:318
msgid "General"
msgstr "Generale"

#: prefs.js:323
msgid "Default GNOME Panel"
msgstr "Pannello GNOME predefinito"

#: prefs.js:324
msgid "Hide taskbar applications and use the original Dash in Overview"
msgstr ""
"Nasconde le applicazioni della barra delle applicazioni e usa la Dash "
"originale nella Panoramica"

#: prefs.js:332
msgid "Panel Button Padding"
msgstr "Spaziatura interna dei pulsanti del pannello"

#: prefs.js:334
msgid ""
"Horizontal space around panel buttons. Use -1 for automatic: Just "
"Perfection’s value when it is configured, otherwise 3 px"
msgstr ""
"Spazio orizzontale attorno ai pulsanti del pannello. Usa -1 per "
"l’automatico: il valore di Just Perfection quando è configurato, altrimenti "
"3 px"

#: prefs.js:341
msgid "Application Icons"
msgstr "Icone delle applicazioni"

#: prefs.js:342 prefs.js:568
msgid "Change the size, spacing, and placement of taskbar icons."
msgstr ""
"Cambia dimensione, spaziatura e posizione delle icone della barra delle "
"applicazioni."

#: prefs.js:348
msgid "Icon Size"
msgstr "Dimensione icone"

#: prefs.js:349
msgid "The panel grows automatically when larger icons need more room"
msgstr ""
"Il pannello si ingrandisce automaticamente quando le icone più grandi "
"necessitano di più spazio"

#: prefs.js:355
msgid "Icon Spacing"
msgstr "Spaziatura icone"

#: prefs.js:356
msgid "Space between application buttons"
msgstr "Spazio tra i pulsanti delle applicazioni"

#: prefs.js:365
msgid "Running Indicator Style"
msgstr "Stile dell’indicatore di esecuzione"

#: prefs.js:367
msgid "Choose the shape of indicators beneath running applications"
msgstr "Scegli la forma degli indicatori sotto le applicazioni in esecuzione"

#: prefs.js:370
msgid "Rounded"
msgstr "Arrotondato"

#: prefs.js:371
msgid "Straight"
msgstr "Diritto"

#: prefs.js:376
msgid "Custom Indicator Colors"
msgstr "Colori personalizzati degli indicatori"

#: prefs.js:377
msgid "Choose colors for running application indicators"
msgstr "Scegli i colori per gli indicatori delle applicazioni in esecuzione"

#: prefs.js:394
msgid "Focused Indicator Color"
msgstr "Colore dell’indicatore per la finestra attiva"

#: prefs.js:402
msgid "Unfocused Indicator Color"
msgstr "Colore dell’indicatore per la finestra non attiva"

#: prefs.js:417
msgid "Icon Alignment"
msgstr "Allineamento icone"

#: prefs.js:418
msgid "Place application icons at the left or center"
msgstr "Posiziona le icone delle applicazioni a sinistra o al centro"

#: prefs.js:423
msgid "Hide Pinned Applications"
msgstr "Nascondi applicazioni bloccate"

#: prefs.js:424
msgid "Show pinned taskbar applications only while they are running"
msgstr ""
"Mostra le applicazioni bloccate nella barra delle applicazioni solo mentre "
"sono in esecuzione"

#: prefs.js:438
#, fuzzy
msgid "Use Pinned Apps as Application Launchers"
msgstr "Nascondi applicazioni bloccate"

#: prefs.js:440
msgid ""
"Keep pinned applications as launchers and show running applications "
"separately"
msgstr ""

#: prefs.js:459
msgid "Combine Application Buttons"
msgstr "Combina pulsanti delle applicazioni"

#: prefs.js:460
msgid "Choose when windows share one taskbar button"
msgstr ""
"Scegli quando le finestre condividono un unico pulsante della barra delle "
"applicazioni"

#: prefs.js:462
msgid "Always"
msgstr "Sempre"

#: prefs.js:463
msgid "Only When Full"
msgstr "Solo quando piena"

#: prefs.js:464
msgid "Never"
msgstr "Mai"

#: prefs.js:470
msgid "Hide App Labels"
msgstr "Nascondi etichette applicazioni"

#: prefs.js:471
msgid "Show only icons on separate window buttons"
msgstr "Mostra solo le icone sui pulsanti delle finestre separate"

#: prefs.js:493
msgid "Show running applications from the current workspace only"
msgstr ""
"Mostra solo le applicazioni in esecuzione dello spazio di lavoro corrente"

#: prefs.js:506
msgid "Show running applications only on the taskbar for their monitor"
msgstr ""
"Mostra le applicazioni in esecuzione solo sulla barra delle applicazioni del "
"proprio monitor"

#: prefs.js:518
msgid "Spread Multiple Windows"
msgstr "Distribuisci finestre multiple"

#: prefs.js:519
msgid ""
"Click an app with multiple windows to show only its windows in Overview, "
"across all workspaces"
msgstr ""
"Fai clic su un’applicazione con più finestre per mostrare solo le sue "
"finestre nella Panoramica, in tutti gli spazi di lavoro"

#: prefs.js:533
msgid "Nautilus Folder Shortcuts"
msgstr "Scorciatoie cartelle di Nautilus"

#: prefs.js:534
msgid "Show common folders in the Files taskbar menu"
msgstr "Mostra le cartelle comuni nel menu File della barra delle applicazioni"

#: prefs.js:567
msgid "Application icons are unavailable in Default GNOME Panel mode."
msgstr ""
"Le icone delle applicazioni non sono disponibili in modalità Pannello GNOME "
"predefinito."

#: prefs.js:570
msgid "Application options are unavailable in Default GNOME Panel mode."
msgstr ""
"Le opzioni delle applicazioni non sono disponibili in modalità Pannello "
"GNOME predefinito."

#: prefs.js:651
msgid "Panel Appearance"
msgstr "Aspetto del pannello"

#: prefs.js:652
msgid "Change the taskbar height, colour scheme, and transparency."
msgstr ""
"Cambia l’altezza, lo schema di colori e la trasparenza della barra delle "
"applicazioni."

#: prefs.js:658
msgid "Panel Height"
msgstr "Altezza del pannello"

#: prefs.js:659
msgid "Oversized icons shrink automatically when the panel is reduced"
msgstr ""
"Le icone troppo grandi si riducono automaticamente quando il pannello viene "
"ridotto"

#: prefs.js:665 prefs.js:2247
msgid "Panel Position"
msgstr "Posizione del pannello"

#: prefs.js:666
msgid "Place the taskbar at the top or bottom of the screen"
msgstr "Posiziona la barra delle applicazioni in alto o in basso sullo schermo"

#: prefs.js:668
msgid "Top"
msgstr "In alto"

#: prefs.js:669
msgid "Bottom"
msgstr "In basso"

#: prefs.js:700
msgid "Follow System Theme"
msgstr "Segui il tema di sistema"

#: prefs.js:701
msgid ""
"Match the active GNOME Shell theme, independently of application colours"
msgstr ""
"Corrisponde al tema attivo di GNOME Shell, indipendentemente dai colori "
"delle applicazioni"

#: prefs.js:717
msgid "Taskbar Theme"
msgstr "Tema della barra delle applicazioni"

#: prefs.js:718
msgid "Choose the colour scheme when system matching is off"
msgstr ""
"Scegli lo schema di colori quando la corrispondenza col sistema è disattivata"

#: prefs.js:720 prefs.js:1413
msgid "Light"
msgstr "Chiaro"

#: prefs.js:721 prefs.js:1412
msgid "Dark"
msgstr "Scuro"

#: prefs.js:736
msgid "Make the taskbar background transparent"
msgstr "Rende trasparente lo sfondo della barra delle applicazioni"

#: prefs.js:739 prefs.js:1437
msgid "Disable Blur My Shell panel blur to use this option"
msgstr ""
"Disabilita la sfocatura del pannello di Blur My Shell per usare questa "
"opzione"

#: prefs.js:742
msgid "Enable Transparency"
msgstr "Abilita trasparenza"

#: prefs.js:755
msgid "0% is opaque and 100% is fully transparent"
msgstr "0% è opaco e 100% è completamente trasparente"

#: prefs.js:762
msgid "Transparency"
msgstr "Trasparenza"

#: prefs.js:787
msgid "Use a chosen color instead of the light or dark theme color"
msgstr "Usa un colore scelto invece del colore del tema chiaro o scuro"

#: prefs.js:790
msgid "Custom Taskbar Color"
msgstr "Colore personalizzato della barra delle applicazioni"

#: prefs.js:808
msgid "Taskbar Color"
msgstr "Colore della barra delle applicazioni"

#: prefs.js:812
msgid ""
"White text uses the dark panel theme; black text uses the light panel theme"
msgstr ""
"Il testo bianco usa il tema scuro del pannello; il testo nero usa il tema "
"chiaro del pannello"

#: prefs.js:819
msgid "Taskbar Text Color"
msgstr "Colore del testo della barra delle applicazioni"

#: prefs.js:822
msgid "White"
msgstr "Bianco"

#: prefs.js:823
msgid "Black"
msgstr "Nero"

#: prefs.js:870
msgid "Show Border in Dark Mode"
msgstr "Mostra bordo in modalità scura"

#: prefs.js:871 prefs.js:884
msgid "Display a thin border along the panel’s workspace-facing edge"
msgstr ""
"Mostra un sottile bordo lungo il bordo del pannello rivolto verso lo spazio "
"di lavoro"

#: prefs.js:883
msgid "Show Border in Light Mode"
msgstr "Mostra bordo in modalità chiara"

#: prefs.js:903
msgid "Auto-hide Panel"
msgstr "Nascondi automaticamente il pannello"

#: prefs.js:904
msgid "Reveal the taskbar when the pointer reaches its screen edge"
msgstr ""
"Mostra la barra delle applicazioni quando il puntatore raggiunge il bordo "
"dello schermo"

#: prefs.js:916
msgid "Bottom Hot Edge"
msgstr "Bordo attivo inferiore"

#: prefs.js:917
msgid "Push the pointer against the bottom screen edge to toggle Overview"
msgstr ""
"Spingi il puntatore contro il bordo inferiore dello schermo per attivare la "
"Panoramica"

#: prefs.js:935
msgid "Activation Pressure"
msgstr "Pressione di attivazione"

#: prefs.js:937
msgid ""
"Pixels the pointer must travel past the bottom edge before Overview activates"
msgstr ""
"Pixel che il puntatore deve percorrere oltre il bordo inferiore prima che si "
"attivi la Panoramica"

#: prefs.js:946
msgid "Hot Edge Animation"
msgstr "Animazione del bordo attivo"

#: prefs.js:947
msgid "Show a ripple when the bottom hot edge activates"
msgstr "Mostra un’onda quando si attiva il bordo attivo inferiore"

#: prefs.js:969
msgid "Workspace Scroll"
msgstr "Scorrimento spazi di lavoro"

#: prefs.js:970
msgid "Scroll over empty taskbar space to switch workspaces"
msgstr ""
"Scorri sopra lo spazio vuoto della barra delle applicazioni per cambiare "
"spazio di lavoro"

#: prefs.js:986
msgid "Workspace Scroll Delay"
msgstr "Ritardo di scorrimento spazi di lavoro"

#: prefs.js:987
msgid "Minimum delay between workspace changes in milliseconds"
msgstr "Ritardo minimo tra i cambi di spazio di lavoro in millisecondi"

#: prefs.js:999
msgid "Middle Click Closes Applications"
msgstr "Il clic centrale chiude le applicazioni"

#: prefs.js:1000
msgid "Close all application windows instead of opening a new window"
msgstr "Chiude tutte le finestre dell’applicazione invece di aprirne una nuova"

#: prefs.js:1012
msgid "Panel Menus Require Click"
msgstr "I menu del pannello richiedono il clic"

#: prefs.js:1013
msgid "Switch between clock, system, and tray menus only when clicked"
msgstr ""
"Passa tra i menu di orologio, sistema e area di notifica solo quando vengono "
"cliccati"

#: prefs.js:1025
msgid "Taskbar-aligned Notification Banners"
msgstr "Banner di notifica allineati alla barra delle applicazioni"

#: prefs.js:1026
msgid "Follow the taskbar edge and the clock’s horizontal position"
msgstr ""
"Segue il bordo della barra delle applicazioni e la posizione orizzontale "
"dell’orologio"

#: prefs.js:1064
msgid "Automatic Fallback"
msgstr "Ripiego automatico"

#: prefs.js:1072
msgid "Task Manager Application"
msgstr "Applicazione gestore attività"

#: prefs.js:1073
msgid "Application opened from the taskbar context menu"
msgstr ""
"Applicazione aperta dal menu contestuale della barra delle applicazioni"

#: prefs.js:1088
msgid "Show Taskbar on All Monitors"
msgstr "Mostra la barra delle applicazioni su tutti i monitor"

#: prefs.js:1089
msgid "Show Activities, applications, clock, and system menu on every monitor"
msgstr ""
"Mostra Attività, applicazioni, orologio e menu di sistema su ogni monitor"

#: prefs.js:1110
msgid "Panel Items"
msgstr "Elementi del pannello"

#: prefs.js:1111
msgid "Choose which optional panel items appear."
msgstr "Scegli quali elementi opzionali del pannello vengono visualizzati."

#: prefs.js:1122
msgid "Place the Start button at the left edge or in the center"
msgstr "Posiziona il pulsante Start sul bordo sinistro o al centro"

#: prefs.js:1129
msgid "Follow Application Alignment"
msgstr "Segui l’allineamento delle applicazioni"

#: prefs.js:1130
msgid "Move the Start button with the application buttons"
msgstr "Sposta il pulsante Start insieme ai pulsanti delle applicazioni"

#: prefs.js:1162
msgid "Start Button Padding"
msgstr "Spaziatura interna del pulsante Start"

#: prefs.js:1163
msgid "Horizontal space around the Start icon in pixels"
msgstr "Spazio orizzontale attorno all’icona Start in pixel"

#: prefs.js:1169
msgid "Custom Start Button Icon"
msgstr "Icona personalizzata del pulsante Start"

#: prefs.js:1173
msgid "Use the built-in icon"
msgstr "Usa l’icona integrata"

#: prefs.js:1177 prefs.js:1716
msgid "Choose…"
msgstr "Scegli…"

#: prefs.js:1193
msgid "Using the built-in icon"
msgstr "Utilizzo dell’icona integrata"

#: prefs.js:1216
msgid "Replace the GNOME app grid with an Eleven-style menu"
msgstr "Sostituisce la griglia app di GNOME con un menu in stile Eleven"

#: prefs.js:1228
msgid "Show Profile Picture"
msgstr "Mostra immagine del profilo"

#: prefs.js:1229
msgid "Use your account picture in the Start Menu"
msgstr "Usa l’immagine del tuo account nel menu Start"

#: prefs.js:1250
msgid "Power Options in Start Menu"
msgstr "Opzioni di alimentazione nel menu Start"

#: prefs.js:1252
msgid "Show power actions here instead of in Quick Settings"
msgstr ""
"Mostra qui le azioni di alimentazione invece che nelle Impostazioni rapide"

#: prefs.js:1274
msgid "Open All Apps by Default"
msgstr "Apri Tutte le app come impostazione predefinita"

#: prefs.js:1275
msgid "Skip Pinned and open directly to applications and categories"
msgstr "Salta Bloccate e apri direttamente su applicazioni e categorie"

#: prefs.js:1296
msgid "Show Recommended Apps"
msgstr "Mostra app consigliate"

#: prefs.js:1297
msgid "Display frequently used applications below pinned apps"
msgstr "Mostra le applicazioni usate di frequente sotto le app bloccate"

#: prefs.js:1309
msgid "Hide Pinned App Titles"
msgstr "Nascondi titoli delle app bloccate"

#: prefs.js:1311
msgid ""
"Hide the names below pinned icons and show them in a tooltip when hovered"
msgstr ""
"Nasconde i nomi sotto le icone bloccate e li mostra in un suggerimento al "
"passaggio del mouse"

#: prefs.js:1345
msgid "Organize All Apps into Categories"
msgstr "Organizza tutte le app in categorie"

#: prefs.js:1346
msgid "Browse applications by category in the Start menu"
msgstr "Sfoglia le applicazioni per categoria nel menu Start"

#: prefs.js:1368
msgid "Show Original GNOME Button"
msgstr "Mostra pulsante GNOME originale"

#: prefs.js:1369
msgid ""
"Show the Applications button when the Eleven-style Start Menu is disabled"
msgstr ""
"Mostra il pulsante Applicazioni quando il menu Start in stile Eleven è "
"disabilitato"

#: prefs.js:1390
msgid "Follow Panel Theme"
msgstr "Segui il tema del pannello"

#: prefs.js:1391
msgid "Use the panel’s effective light or dark appearance"
msgstr "Usa l’aspetto chiaro o scuro effettivo del pannello"

#: prefs.js:1409
msgid "Start Menu Theme"
msgstr "Tema del menu Start"

#: prefs.js:1410
msgid "Use a custom appearance or follow the GNOME Shell theme"
msgstr "Usa un aspetto personalizzato o segui il tema di GNOME Shell"

#: prefs.js:1414
msgid "GNOME Shell"
msgstr "GNOME Shell"

#: prefs.js:1434
msgid "Use the panel’s configured transparency level"
msgstr "Usa il livello di trasparenza configurato del pannello"

#: prefs.js:1440
msgid "Disable Blur My Shell popup blur to use this option"
msgstr ""
"Disabilita la sfocatura dei popup di Blur My Shell per usare questa opzione"

#: prefs.js:1443
msgid "Disable Blur My Shell panel and popup blur to use this option"
msgstr ""
"Disabilita la sfocatura del pannello e dei popup di Blur My Shell per usare "
"questa opzione"

#: prefs.js:1446
msgid "Follow Panel Transparency"
msgstr "Segui la trasparenza del pannello"

#: prefs.js:1487
msgid "Center Start Menu on Monitor"
msgstr "Centra il menu Start sul monitor"

#: prefs.js:1488
msgid ""
"Place the menu at the true horizontal center instead of over the Start button"
msgstr ""
"Posiziona il menu al vero centro orizzontale invece che sopra il pulsante "
"Start"

#: prefs.js:1526
msgid "Super Opens Start Menu"
msgstr "Super apre il menu Start"

#: prefs.js:1527
msgid "Use Super for the Start Menu and move Overview to Super+Tab"
msgstr "Usa Super per il menu Start e sposta la Panoramica su Super+Tab"

#: prefs.js:1539
msgid "Super+Tab Opens Start Menu"
msgstr "Super+Tab apre il menu Start"

#: prefs.js:1540
msgid ""
"Use GNOME’s application-switch shortcut for the Eleven-style Start Menu "
"while it is enabled"
msgstr ""
"Usa la scorciatoia di cambio applicazione di GNOME per il menu Start in "
"stile Eleven mentre è abilitato"

#: prefs.js:1567
msgid "Super+E Opens File Manager"
msgstr "Super+E apre il gestore file"

#: prefs.js:1569
msgid "Open your home folder with the system’s default file manager"
msgstr "Apre la tua cartella Home con il gestore file predefinito del sistema"

#: prefs.js:1584
msgid "Not set"
msgstr "Non impostato"

#: prefs.js:1589
msgid "Set custom shortcut"
msgstr "Imposta scorciatoia personalizzata"

#: prefs.js:1594
msgid "Clear custom shortcut"
msgstr "Cancella scorciatoia personalizzata"

#: prefs.js:1598
msgid "Custom Start Menu Shortcut"
msgstr "Scorciatoia personalizzata del menu Start"

#: prefs.js:1617
msgid "Turn off the Super shortcut to use a custom shortcut"
msgstr ""
"Disattiva la scorciatoia Super per usare una scorciatoia personalizzata"

#: prefs.js:1620
msgid "Turn off Super+Tab to use a custom shortcut"
msgstr "Disattiva Super+Tab per usare una scorciatoia personalizzata"

#: prefs.js:1623
msgid "Choose any unused keyboard shortcut; none is assigned by default"
msgstr ""
"Scegli una qualsiasi scorciatoia da tastiera non utilizzata; nessuna è "
"assegnata per impostazione predefinita"

#: prefs.js:1646
msgid "Show Activities Button"
msgstr "Mostra pulsante Attività"

#: prefs.js:1647
msgid "Display GNOME’s workspace overview button on the taskbar"
msgstr ""
"Mostra il pulsante della panoramica degli spazi di lavoro di GNOME sulla "
"barra delle applicazioni"

#: prefs.js:1659 prefs.js:1824
msgid "Show Desktop Button"
msgstr "Mostra pulsante Mostra desktop"

#: prefs.js:1660
msgid "Display a button that minimizes or restores all windows"
msgstr "Mostra un pulsante che minimizza o ripristina tutte le finestre"

#: prefs.js:1674
msgid "Application Volume Mixer"
msgstr "Mixer del volume delle applicazioni"

#: prefs.js:1675
msgid "Add per-application volume controls to Quick Settings"
msgstr ""
"Aggiunge controlli del volume per applicazione alle Impostazioni rapide"

#: prefs.js:1687
msgid "Collect Tray Icons"
msgstr "Raccogli icone dell’area di notifica"

#: prefs.js:1688 prefs.js:1808
msgid "Gather application tray icons behind a panel arrow"
msgstr ""
"Raggruppa le icone dell’area di notifica delle applicazioni dietro una "
"freccia del pannello"

#: prefs.js:1700
msgid "Show Folder Menu"
msgstr "Mostra menu cartella"

#: prefs.js:1701
msgid "Show a selected folder on the taskbar"
msgstr "Mostra una cartella selezionata sulla barra delle applicazioni"

#: prefs.js:1713
msgid "Folder Menu Location"
msgstr "Posizione del menu cartella"

#: prefs.js:1731
msgid "No folder selected"
msgstr "Nessuna cartella selezionata"

#: prefs.js:1747
msgid "Left Items"
msgstr "Elementi a sinistra"

#: prefs.js:1749
