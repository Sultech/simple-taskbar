#: prefs/panelItemsPage.js:193 trayOverflowController.js:199
msgid "Tray icons"
msgstr "Icone dell’area di notifica"

#: prefs/panelItemsPage.js:199
msgid "System Menu"
msgstr "Menu di sistema"

#: prefs/panelItemsPage.js:200
msgid "Quick Settings, volume, network, and power"
msgstr "Impostazioni rapide, volume, rete e alimentazione"

#: prefs/panelItemsPage.js:205
msgid "Clock"
msgstr "Orologio"

#: prefs/panelItemsPage.js:211
msgid "Minimize or restore all windows"
msgstr "Minimizza o ripristina tutte le finestre"

#: prefs/preferencesDialogs.js:15
msgid "Reset all settings?"
msgstr "Ripristinare tutte le impostazioni?"

#: prefs/preferencesDialogs.js:17
msgid ""
"This will restore taskbar and Start Menu settings. Pinned taskbar and Start "
"Menu apps, including their order, will be kept."
msgstr ""
"Questo ripristinerà le impostazioni della barra delle applicazioni e del "
"menu Start. Le app bloccate nella barra delle applicazioni e nel menu Start, "
"incluso il loro ordine, verranno mantenute."

#: prefs/preferencesDialogs.js:20 prefs/startIconChooser.js:139
msgid "Cancel"
msgstr "Annulla"

#: prefs/preferencesDialogs.js:54
msgid "Set Custom Shortcut"
msgstr "Imposta scorciatoia personalizzata"

#: prefs/preferencesDialogs.js:67
msgid "Press a keyboard shortcut"
msgstr "Premi una scorciatoia da tastiera"

#: prefs/preferencesDialogs.js:68
msgid "Press Backspace to clear it, or Escape to cancel."
msgstr "Premi Backspace per cancellarla, o Esc per annullare."

#: prefs/preferencesDialogs.js:108
msgid "That shortcut needs a modifier key. Try another shortcut."
msgstr ""
"Quella scorciatoia richiede un tasto modificatore. Prova un’altra "
"scorciatoia."

#: prefs/preferencesDialogs.js:122
msgid "That shortcut is already in use. Press a different shortcut."
msgstr "Quella scorciatoia è già in uso. Premi una scorciatoia diversa."

#: prefs/preferencesDialogs.js:140
msgid "Choose a Folder"
msgstr "Scegli una cartella"

#: prefs/preferencesWidgets.js:95
msgid "Move Up"
msgstr "Sposta su"

#: prefs/preferencesWidgets.js:100
msgid "Move Down"
msgstr "Sposta giù"

#: prefs/startMenuPage.js:30
msgid "Configure the Start button position and spacing."
msgstr "Configura la posizione e la spaziatura del pulsante Start."

#: prefs/startMenuPage.js:35 prefs/startMenuPage.js:193
msgid "Eleven-style Start Menu"
msgstr "Menu Start in stile Eleven"

#: prefs/startMenuPage.js:36
msgid "Configure the optional Eleven-style application menu."
msgstr "Configura il menu applicazioni opzionale in stile Eleven."

#: prefs/startMenuPage.js:41
msgid "Keyboard Shortcuts"
msgstr "Scorciatoie da tastiera"

#: prefs/startMenuPage.js:42
msgid "Configure Start menu shortcuts."
msgstr "Configura le scorciatoie del menu Start."

#: prefs/startMenuPage.js:74
msgid "Place the Start button at the left edge or in the center"
msgstr "Posiziona il pulsante Start sul bordo sinistro o al centro"

#: prefs/startMenuPage.js:81
msgid "Follow Application Alignment"
msgstr "Segui l’allineamento delle applicazioni"

#: prefs/startMenuPage.js:82
msgid "Move the Start button with the application buttons"
msgstr "Sposta il pulsante Start insieme ai pulsanti delle applicazioni"

#: prefs/startMenuPage.js:126
msgid "Start Button Padding"
msgstr "Spaziatura interna del pulsante Start"

#: prefs/startMenuPage.js:127
msgid "Horizontal space around the Start icon in pixels"
msgstr "Spazio orizzontale attorno all’icona Start in pixel"

#: prefs/startMenuPage.js:134
msgid "Custom Start Button Icon"
msgstr "Icona personalizzata del pulsante Start"

#: prefs/startMenuPage.js:138
msgid "Use the built-in icon"
msgstr "Usa l’icona integrata"

#: prefs/startMenuPage.js:158
msgid "Using the built-in icon"
msgstr "Utilizzo dell’icona integrata"

#: prefs/startMenuPage.js:194
msgid "Replace the GNOME app grid with an Eleven-style menu"
msgstr "Sostituisce la griglia app di GNOME con un menu in stile Eleven"

#: prefs/startMenuPage.js:206
msgid "Show Profile Picture"
msgstr "Mostra immagine del profilo"

#: prefs/startMenuPage.js:207
msgid "Use your account picture in the Start Menu"
msgstr "Usa l’immagine del tuo account nel menu Start"

#: prefs/startMenuPage.js:228
msgid "Power Options in Start Menu"
