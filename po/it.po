#: prefs/panelItemsPage.js:135
msgid "Move items only within their current panel position."
msgstr ""
"Sposta gli elementi solo all’interno della loro posizione attuale nel "
"pannello."

#: prefs/panelItemsPage.js:139
msgid "Center Items"
msgstr "Elementi al centro"

#: prefs/panelItemsPage.js:142
